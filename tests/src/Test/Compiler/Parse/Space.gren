module Test.Compiler.Parse.Space exposing ( tests )

import Expect exposing (Expectation)
import Test exposing (Test, describe, test)
import String.Parser.Advanced as Parser exposing (Parser)
import Compiler.Parse.Space as PS
import Compiler.Parse.Context as Context exposing (Context)
import Dict
import Compiler.SourcePosition as SourcePosition
import Array.Builder


tests : Test
tests =
    describe "Parse.Space"
        [ describe "parser"
            [ test "parses spaces" <| \_ ->
                Parser.run PS.parser Context.empty "   "
                    |> Expect.equal (Ok {})
            , test "parses newlines" <| \_ ->
                Parser.run PS.parser Context.empty "\n"
                    |> Expect.equal (Ok {})
            , test "parses mixed whitespace" <| \_ ->
                Parser.run PS.parser Context.empty " \n \r "
                    |> Expect.equal (Ok {})
            , test "parses empty string" <| \_ ->
                Parser.run PS.parser Context.empty ""
                    |> Expect.equal (Ok {})
            , test "can read from context where the first non-space col began" <| \_ ->
                Parser.run payloadParser Context.empty "a"
                    |> expectLineStart 1
            , test "can read from context where the first non-space col began (indented)" <| \_ ->
                Parser.run payloadParser Context.empty "   a"
                    |> expectLineStart 4
            , test "line comment counts as start of line" <| \_ ->
                Parser.run payloadParser Context.empty " -- test"
                    |> expectLineStart 2
            , test "block comment counts as start of line" <| \_ ->
                Parser.run payloadParser Context.empty "  {- test -}"
                    |> expectLineStart 3
            , test "setIndentToStartOfLine" <| \_ ->
                let
                    setIndentParser =
                        Parser.succeed identity
                            |> Parser.skip PS.parser
                            |> Parser.keep (PS.scopeIndentToLineStart Parser.getPayload)
                in
                Parser.run setIndentParser Context.empty "    b"
                    |> Result.map .indent
                    |> Expect.equal (Ok 5)
            , test "setIndentToStartOfLine preserves startLine on same row" <| \_ ->
                let
                    setIndentParser =
                        Parser.succeed identity
                            |> Parser.skip PS.parser
                            |> Parser.skip (Parser.chompChar 'b' PS.InvalidWhiteSpace)
                            |> Parser.skip PS.parser
                            |> Parser.skip (Parser.chompChar 'c' PS.InvalidWhiteSpace)
                            |> Parser.skip PS.parser
                            |> Parser.keep (PS.scopeIndentToLineStart Parser.getPayload)
                in
                Parser.run setIndentParser Context.empty "   b  c  d"
                    |> Result.map .indent
                    |> Expect.equal (Ok 4)
            , test "setIndentToStartOfLinePlus1" <| \_ ->
                let
                    setIndentParser =
                        Parser.succeed identity
                            |> Parser.skip PS.parser
                            |> Parser.keep (PS.scopeIndentToLineStartPlus1 Parser.getPayload)
                in
                Parser.run setIndentParser Context.empty "    b"
                    |> Result.map .indent
                    |> Expect.equal (Ok 6)
            , test "setIndentToCurrentColumn" <| \_ ->
                let
                    setIndentParser =
                        Parser.succeed identity
                            |> Parser.skip PS.parser
                            |> Parser.skip (Parser.token "b" PS.InvalidWhiteSpace)
                            |> Parser.skip PS.parser
                            |> Parser.keep (PS.scopeIndentToCurrentColumn Parser.getPayload)
                in
                Parser.run setIndentParser Context.empty "    b a"
                    |> Result.map .indent
                    |> Expect.equal (Ok 7)
            ]
    , describe "comments" <|
        [ test "parses line comments" <| \_ ->
            Parser.run (parseToEnd payloadParser) Context.empty "-- this is a line comment"
                |> expectComment
                    (SourcePosition.at
                        { row = 1, col = 1 }
                        { row = 1, col = 26 }
                        (Context.Line " this is a line comment" )
                    )
        , test "parses line comments even when prefixed with space" <| \_ ->
            Parser.run (parseToEnd payloadParser) Context.empty "  -- this is a line comment"
                |> expectComment
                    (SourcePosition.at
                        { row = 1, col = 3 }
                        { row = 1, col = 28 }
                        (Context.Line " this is a line comment")
                    )
        , test "block comments" <| \_ ->
            Parser.run (parseToEnd payloadParser) Context.empty "{- this is a block comment -}"
                |> expectComment
                    (SourcePosition.at
                        { row = 1, col = 1 }
                        { row = 1, col = 30 }
                        (Context.Block " this is a block comment ")
                    )
        , test "nested block comment" <| \_ ->
            Parser.run (parseToEnd payloadParser) Context.empty "{- checks for --, {- -} and {-| -} comments. -}"
                |> expectComment
                    (SourcePosition.at
                        { row = 1, col = 1 }
                        { row = 1, col = 48 }
                        (Context.Block " checks for --, {- -} and {-| -} comments. ")
                    )
        ]
    , describe "checkIndent" <|
        let
            indentParser =
                Parser.succeed {}
                    |> Parser.skip PS.parser
                    |> Parser.mapError (\_ -> {})
                    |> Parser.andThen (\_ -> PS.checkIndent)
        in    
        [ test "succeeds when column is greater than indent" <| \_ ->
            let
                context =
                    { Context.empty | indent = 2 }
            in
            Parser.run indentParser context "  x"
                |> Expect.equal (Ok {})
        , test "fails when column is less than indent" <| \_ ->
            let
                context =
                    { Context.empty | indent = 4 }
            in
            Parser.run indentParser context "  x"
                |> expectProblem
        , test "fails when column is 1" <| \_ ->
            let
                context =
                    { Context.empty | indent = 1 }
            in
            Parser.run indentParser context "x"
                |> expectProblem
        ]
    , describe "checkIndentAtLeastEqual" <|
        let
            indentParser =
                Parser.succeed {}
                    |> Parser.skip PS.parser
                    |> Parser.mapError (\_ -> {})
                    |> Parser.andThen (\_ -> PS.checkIndentAtLeastEqual)
        in    
        [ test "succeeds when column is greater than indent" <| \_ ->
            let
                context =
                    { Context.empty | indent = 2 }
            in
            Parser.run indentParser context "  x"
                |> Expect.equal (Ok {})
        , test "succeeds when column is equal to indent" <| \_ ->
            let
                context =
                    { Context.empty | indent = 2 }
            in
            Parser.run indentParser context " x"
                |> Expect.equal (Ok {})
        , test "fails when column is less than indent" <| \_ ->
            let
                context =
                    { Context.empty | indent = 4 }
            in
            Parser.run indentParser context "  x"
                |> expectProblem
        , test "fails when column is 1" <| \_ ->
            let
                context =
                    { Context.empty | indent = 1 }
            in
            Parser.run indentParser context "x"
                |> expectProblem
        ]
    , describe "checkIndentExact" <|
        let
            indentParser =
                Parser.succeed {}
                    |> Parser.skip PS.parser
                    |> Parser.mapError (\_ -> {})
                    |> Parser.andThen (\_ -> PS.checkIndentExact)
        in    
        [ test "fails when column is greater than indent" <| \_ ->
            let
                context =
                    { Context.empty | indent = 2 }
            in
            Parser.run indentParser context "  x"
                |> expectProblem
        , test "fails when column is less than indent" <| \_ ->
            let
                context =
                    { Context.empty | indent = 4 }
            in
            Parser.run indentParser context "  x"
                |> expectProblem
        , test "succeeds when column is exactly the indent" <| \_ ->
            let
                context =
                    { Context.empty | indent = 3 }
            in
            Parser.run indentParser context "  x"
                |> Expect.equal (Ok {})
        ]
    ]


expectProblem : Result x y -> Expectation
expectProblem result =
    when result is
        Ok _ ->
            Expect.fail "Expected parser to fail but it succeeded"
        Err _ ->
            Expect.pass


payloadParser : Parser Context PS.Error Context
payloadParser =
    Parser.succeed identity
        |> Parser.skip PS.parser
        |> Parser.keep Parser.getPayload


parseToEnd : Parser Context PS.Error a -> Parser Context PS.Error a
parseToEnd p =
    Parser.skip (Parser.end PS.InvalidWhiteSpace) p


expectComment : SourcePosition.Located Context.Comment -> Result x Context -> Expectation
expectComment comment resultContext =
    when resultContext is
        Err err ->
            Expect.fail ("Failed to parse with error: " ++ Debug.toString err)

        Ok ctx ->
            Expect.equal [ comment ] (Array.Builder.toArray ctx.comments)


expectLineStart : Int -> Result x Context -> Expectation
expectLineStart col resultContext =
    when resultContext is
        Err err ->
            Expect.fail ("Failed to parse with error: " ++ Debug.toString err)

        Ok ctx ->
            Expect.equal col ctx.lineStart
