module Test.Compiler.Parse.Pattern exposing ( tests )

import Expect exposing (Expectation)
import Test exposing (Test, describe, test, fuzz)
import Fuzz exposing (Fuzzer)
import String.Parser.Advanced as Parser
import Compiler.Parse.Pattern as PT
import Compiler.Ast.Source as AST
import Compiler.SourcePosition as SourcePosition
import Compiler.Parse.Context as Context


tests : Test
tests =
    describe "Parse.Pattern"
        [ test "vars" <| \_ ->
            Parser.run PT.parser Context.empty "var"
                |> expectPattern (AST.PVar "var")
        , test "wildcard" <| \_ ->
            Parser.run PT.parser Context.empty "_"
                |> expectPattern (AST.PAnything "")
        , test "wildcard (named)" <| \_ ->
            Parser.run PT.parser Context.empty "_test"
                |> expectPattern (AST.PAnything "test")
        , test "constructor (unqualified)" <| \_ ->
            Parser.run PT.parser Context.empty "Ctor"
                |> expectPattern
                    (AST.PCtor
                        { arg = Nothing
                        , name =
                            SourcePosition.at
                                { row = 1, col = 1 }
                                { row = 1, col = 5 }
                                "Ctor"
                        }
                    )
        , test "constructor (qualified)" <| \_ ->
            Parser.run PT.parser Context.empty "My.Ctor"
                |> expectPattern
                    (AST.PCtorQual
                        { varRegion =
                            { start = { row = 1, col = 1 }
                            , end = { row = 1, col = 8 }
                            }
                        , arg = Nothing
                        , module_ = "My"
                        , name = "Ctor"
                        }
                    )
        , test "constructor with args requires parens" <| \_ ->
            Parser.run PT.parser Context.empty "Ctor arg"
                |> expectPattern
                    (AST.PCtor
                        { arg = Nothing
                        , name =
                            SourcePosition.at
                                { row = 1, col = 1 }
                                { row = 1, col = 5 }
                                "Ctor"
                        }
                    )
        , test "constructor (with arg)" <| \_ ->
            Parser.run PT.parser Context.empty "(Ctor arg)"
                |> expectPattern
                    (AST.PCtor
                        { arg =
                            Just <|
                                SourcePosition.at
                                    { row = 1, col = 7 }
                                    { row = 1, col = 10 }
                                    (AST.PVar "arg")
                        , name =
                            SourcePosition.at
                                { row = 1, col = 2 }
                                { row = 1, col = 6 }
                                "Ctor"
                        }
                    )
        , test "constructor (with arg and whitespace)" <| \_ ->
            Parser.run PT.parser Context.empty "( Ctor arg )"
                |> expectPattern
                    (AST.PCtor
                        { arg =
                            Just <|
                                SourcePosition.at
                                    { row = 1, col = 8 }
                                    { row = 1, col = 11 }
                                    (AST.PVar "arg")
                        , name =
                            SourcePosition.at
                                { row = 1, col = 3 }
                                { row = 1, col = 7 }
                                "Ctor"
                        }
                    )
        , test "constructor (with args and alias)" <| \_ ->
            Parser.run PT.parser Context.empty "(Ctor arg) as myVar"
                |> expectPattern
                    (AST.PAlias
                        { pattern =
                            SourcePosition.at
                                { row = 1, col = 2 }
                                { row = 1, col = 10 }
                                ( AST.PCtor
                                    { arg =
                                        Just <|
                                            SourcePosition.at
                                                { row = 1, col = 7 }
                                                { row = 1, col = 10 }
                                                (AST.PVar "arg")
                                    , name =
                                        SourcePosition.at
                                            { row = 1, col = 2 }
                                            { row = 1, col = 6 }
                                            "Ctor"
                                    }
                                )
                        , name =
                            SourcePosition.at
                                { row = 1, col = 15 }
                                { row = 1, col = 20 }
                                "myVar"
                        }
                    )
        , test "constructor (with args and alias inside parens)" <| \_ ->
            Parser.run PT.parser Context.empty "(Ctor arg as myVar)"
                |> expectPattern
                    (AST.PAlias
                        { pattern =
                            SourcePosition.at
                                { row = 1, col = 2 }
                                { row = 1, col = 10 }
                                ( AST.PCtor
                                    { arg =
                                        Just <|
                                            SourcePosition.at
                                                { row = 1, col = 7 }
                                                { row = 1, col = 10 }
                                                (AST.PVar "arg")
                                    , name =
                                        SourcePosition.at
                                            { row = 1, col = 2 }
                                            { row = 1, col = 6 }
                                            "Ctor"
                                    }
                                )
                        , name =
                            SourcePosition.at
                                { row = 1, col = 14 }
                                { row = 1, col = 19 }
                                "myVar"
                        }
                    )
        , test "ints" <| \_ ->
            Parser.run PT.parser Context.empty "160"
                |> expectPattern
                    (AST.PInt { isHex = False, value = 160 })
        , test "negative int" <| \_ ->
            -- Has to be wrapped in parens in case of '->'
            Parser.run PT.parser Context.empty "(-10)"
                |> expectPattern
                    (AST.PInt { isHex = False, value = -10 })
        , test "ints (hex)" <| \_ ->
            Parser.run PT.parser Context.empty "0xAB"
                |> expectPattern
                    (AST.PInt { isHex = True, value = 171 })
        , test "string" <| \_ ->
            Parser.run PT.parser Context.empty "\"some String\""
                |> expectPattern
                    (AST.PStr "some String")
        , test "char" <| \_ ->
            Parser.run PT.parser Context.empty "'z'"
                |> expectPattern
                    (AST.PChr 'z')
        , test "array (empty)" <| \_ ->
            Parser.run PT.parser Context.empty "[]"
                |> expectPattern
                    (AST.PArray [])
        , test "array" <| \_ ->
            Parser.run PT.parser Context.empty "[ a, 2, b ]"
                |> expectPattern
                    (AST.PArray
                        [ SourcePosition.at
                            { row = 1, col = 3 }
                            { row = 1, col = 4 }
                            (AST.PVar "a")
                        , SourcePosition.at
                            { row = 1, col = 6 }
                            { row = 1, col = 7 }
                            (AST.PInt { isHex = False, value = 2 })
                        , SourcePosition.at
                            { row = 1, col = 9 }
                            { row = 1, col = 10 }
                            (AST.PVar "b")
                        ]
                    )
        , test "array with constructor" <| \_ ->
            Parser.run PT.parser Context.empty "[ Nothing, Just 1 ]"
                |> expectPattern
                    (AST.PArray
                        [ SourcePosition.at
                            { row = 1, col = 3 }
                            { row = 1, col = 10 }
                            (AST.PCtor
                                { arg = Nothing
                                , name =
                                    SourcePosition.at
                                        { row = 1, col = 3 }
                                        { row = 1, col = 10 }
                                        "Nothing"
                                }
                            )
                        , SourcePosition.at
                            { row = 1, col = 12 }
                            { row = 1, col = 18 }
                            (AST.PCtor
                                { arg =
                                    Just <|
                                        SourcePosition.at
                                            { row = 1, col = 17 }
                                            { row = 1, col = 18 }
                                            (AST.PInt { isHex = False, value = 1 })
                                , name =
                                    SourcePosition.at
                                        { row = 1, col = 12 }
                                        { row = 1, col = 16 }
                                        "Just"
                                }
                            )
                        ]
                    )
        , test "array with constructor and alias" <| \_ ->
            Parser.run PT.parser Context.empty "[ Just 1 as whole ]"
                |> expectPattern
                    (AST.PArray
                        [ SourcePosition.at
                            { row = 1, col = 3 }
                            { row = 1, col = 18 }
                            (AST.PAlias
                                { pattern =
                                    SourcePosition.at
                                        { row = 1, col = 3 }
                                        { row = 1, col = 9 }
                                        (AST.PCtor
                                            { arg =
                                                Just <|
                                                    SourcePosition.at
                                                        { row = 1, col = 8 }
                                                        { row = 1, col = 9 }
                                                        (AST.PInt { isHex = False, value = 1 })
                                            , name =
                                                SourcePosition.at
                                                    { row = 1, col = 3 }
                                                    { row = 1, col = 7 }
                                                    "Just"
                                            }
                                        )
                                , name =
                                    SourcePosition.at
                                        { row = 1, col = 13 }
                                        { row = 1, col = 18 }
                                        "whole"
                                }
                            )
                        ]
                    )
        , test "array with two aliased constructors" <| \_ ->
            Parser.run PT.parser Context.empty "[ Nothing as empty, Just 1 as whole ]"
                |> expectPattern
                    (AST.PArray
                        [ SourcePosition.at
                            { row = 1, col = 3 }
                            { row = 1, col = 19 }
                            (AST.PAlias
                                { pattern =
                                    SourcePosition.at
                                        { row = 1, col = 3 }
                                        { row = 1, col = 10 }
                                        (AST.PCtor
                                            { arg = Nothing
                                            , name =
                                                SourcePosition.at
                                                    { row = 1, col = 3 }
                                                    { row = 1, col = 10 }
                                                    "Nothing"
                                            }
                                        )
                                , name =
                                    SourcePosition.at
                                        { row = 1, col = 14 }
                                        { row = 1, col = 19 }
                                        "empty"
                                }
                            )
                        , SourcePosition.at
                            { row = 1, col = 21 }
                            { row = 1, col = 36 }
                            (AST.PAlias
                                { pattern =
                                    SourcePosition.at
                                        { row = 1, col = 21 }
                                        { row = 1, col = 27 }
                                        (AST.PCtor
                                            { arg =
                                                Just <|
                                                    SourcePosition.at
                                                        { row = 1, col = 26 }
                                                        { row = 1, col = 27 }
                                                        (AST.PInt { isHex = False, value = 1 })
                                            , name =
                                                SourcePosition.at
                                                    { row = 1, col = 21 }
                                                    { row = 1, col = 25 }
                                                    "Just"
                                            }
                                        )
                                , name =
                                    SourcePosition.at
                                        { row = 1, col = 31 }
                                        { row = 1, col = 36 }
                                        "whole"
                                }
                            )
                        ]
                    )
        , test "record (empty)" <| \_ ->
            Parser.run PT.parser Context.empty "{}"
                |> expectPattern
                    (AST.PRecord [])
        , test "record" <| \_ ->
            Parser.run PT.parser Context.empty "{ a = 1, b = _ }"
                |> expectPattern
                    (AST.PRecord
                        [ { field =
                               SourcePosition.at
                                   { row = 1, col = 3 }
                                   { row = 1, col = 4 }
                                   "a"
                           , pattern =
                               Just <|
                                   SourcePosition.at
                                       { row = 1, col = 7 }
                                       { row = 1, col = 8 }
                                       (AST.PInt { isHex = False, value = 1 })
                           }
                        , { field =
                               SourcePosition.at
                                   { row = 1, col = 10 }
                                   { row = 1, col = 11 }
                                   "b"
                           , pattern =
                               Just <|
                                   SourcePosition.at
                                       { row = 1, col = 14 }
                                       { row = 1, col = 15 }
                                       (AST.PAnything "")
                           }
                        ]
                    )
        , test "record with ctor" <| \_ ->
            Parser.run PT.parser Context.empty "{ a = Nothing, b = Just 1 }"
                |> expectPattern
                    (AST.PRecord
                        [ { field =
                               SourcePosition.at
                                   { row = 1, col = 3 }
                                   { row = 1, col = 4 }
                                   "a"
                           , pattern =
                               Just <|
                                   SourcePosition.at
                                       { row = 1, col = 7 }
                                       { row = 1, col = 14 }
                                        (AST.PCtor
                                            { arg = Nothing
                                            , name =
                                                SourcePosition.at
                                                    { row = 1, col = 7 }
                                                    { row = 1, col = 14 }
                                                    "Nothing"
                                            }
                                        )
                           }
                        , { field =
                               SourcePosition.at
                                   { row = 1, col = 16 }
                                   { row = 1, col = 17 }
                                   "b"
                           , pattern =
                               Just <|
                                   SourcePosition.at
                                       { row = 1, col = 20 }
                                       { row = 1, col = 26 }
                                        (AST.PCtor
                                            { arg =
                                                Just <|
                                                    SourcePosition.at
                                                        { row = 1, col = 25 }
                                                        { row = 1, col = 26 }
                                                        (AST.PInt { isHex = False, value = 1 })
                                            , name =
                                                SourcePosition.at
                                                    { row = 1, col = 20 }
                                                    { row = 1, col = 24 }
                                                    "Just"
                                            }
                                        )
                           }
                        ]
                    )
        , test "record with ctor and alias" <| \_ ->
            Parser.run PT.parser Context.empty "{ b = Just 1 as whole }"
                |> expectPattern
                    (AST.PRecord
                        [ { field =
                               SourcePosition.at
                                   { row = 1, col = 3 }
                                   { row = 1, col = 4 }
                                   "b"
                           , pattern =
                               Just <|
                                   SourcePosition.at
                                       { row = 1, col = 7 }
                                       { row = 1, col = 22 }
                                        (AST.PAlias
                                            { pattern =
                                                SourcePosition.at
                                                    { row = 1, col = 7 }
                                                    { row = 1, col = 13 }
                                                    (AST.PCtor
                                                        { arg =
                                                            Just <|
                                                                SourcePosition.at
                                                                    { row = 1, col = 12 }
                                                                    { row = 1, col = 13 }
                                                                    (AST.PInt { isHex = False, value = 1 })
                                                        , name =
                                                            SourcePosition.at
                                                                { row = 1, col = 7 }
                                                                { row = 1, col = 11 }
                                                                "Just"
                                                        }
                                                    )
                                            , name =
                                                SourcePosition.at
                                                    { row = 1, col = 17 }
                                                    { row = 1, col = 22 }
                                                    "whole"
                                            }
                                        )
                           }
                        ]
                    )
        , test "record (shorthand)" <| \_ ->
            Parser.run PT.parser Context.empty "{ a, b = _ }"
                |> expectPattern
                    (AST.PRecord
                        [ { field =
                               SourcePosition.at
                                   { row = 1, col = 3 }
                                   { row = 1, col = 4 }
                                   "a"
                           , pattern =
                                Nothing
                           }
                        , { field =
                               SourcePosition.at
                                   { row = 1, col = 6 }
                                   { row = 1, col = 7 }
                                   "b"
                           , pattern =
                               Just <|
                                   SourcePosition.at
                                       { row = 1, col = 10 }
                                       { row = 1, col = 11 }
                                       (AST.PAnything "")
                           }
                        ]
                    )
        , test "constructor (with array argument)" <| \_ ->
            Parser.run PT.parser Context.empty "(MyArray [ one ])"
                |> expectPattern
                    (AST.PCtor
                        { arg =
                            Just <|
                                SourcePosition.at
                                    { row = 1, col = 10 }
                                    { row = 1, col = 17 }
                                    (AST.PArray
                                        [ SourcePosition.at
                                            { row = 1, col = 12 }
                                            { row = 1, col = 15 }
                                            (AST.PVar "one")
                                        ]
                                    )
                        , name =
                            SourcePosition.at
                                { row = 1, col = 2 }
                                { row = 1, col = 9 }
                                "MyArray"
                        }
                    )
        , test "constructor (with record argument)" <| \_ ->
            Parser.run PT.parser Context.empty "(MyRecord { x = 1 })"
                |> expectPattern
                    (AST.PCtor
                        { arg =
                            Just <|
                                SourcePosition.at
                                    { row = 1, col = 11 }
                                    { row = 1, col = 20 }
                                    (AST.PRecord
                                        [ { field =
                                               SourcePosition.at
                                                   { row = 1, col = 13 }
                                                   { row = 1, col = 14 }
                                                   "x"
                                           , pattern =
                                               Just <|
                                                   SourcePosition.at
                                                       { row = 1, col = 17 }
                                                       { row = 1, col = 18 }
                                                       (AST.PInt { isHex = False, value = 1 })
                                           }
                                        ]
                                    )
                        , name =
                            SourcePosition.at
                                { row = 1, col = 2 }
                                { row = 1, col = 10 }
                                "MyRecord"
                        }
                    )
        ]


expectPattern : a -> Result (Array (Parser.DeadEnd c e)) (SourcePosition.Located a) -> Expectation
expectPattern expected result =
    when result is
        Err err ->
            Expect.fail (Debug.toString err)

        Ok { value } ->
            Expect.equal expected value


expectErr : PT.Error -> Result (Array (Parser.DeadEnd c PT.Error)) a -> Expectation
expectErr expected result =
    when result is
        Ok _ ->
            Expect.fail "Expected error"

        Err problems ->
            when Array.first problems is
                Just firstProblem ->
                    Expect.equal expected firstProblem.problem

                Nothing ->
                    Expect.fail "Failed, but with no problems..."
