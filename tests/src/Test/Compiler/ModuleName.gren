module Test.Compiler.ModuleName exposing (tests)

import Expect exposing (Expectation)
import Test exposing (Test, describe, test)
import Fuzz exposing (Fuzzer)
import Compiler.ModuleName as ModuleName


tests : Test
tests =
    describe "ModuleName"
        [ describe "fromString"
            [ test "valid name" <| \{} ->
                ModuleName.fromString "MyModule"
                    |> Maybe.map ModuleName.toString
                    |> Expect.equal (Just "MyModule")
            , test "unicode" <| \_ ->
                ModuleName.fromString "Åberg"
                    |> Maybe.map ModuleName.toString
                    |> Expect.equal (Just "Åberg")
            , test "underscore" <| \_ ->
                ModuleName.fromString "Slug_"
                    |> Maybe.map ModuleName.toString
                    |> Expect.equal (Just "Slug_")
            , test "with unicode, upper case, digits and underscore" <| \_ ->
                ModuleName.fromString "MiN_1_Øse"
                    |> Maybe.map ModuleName.toString
                    |> Expect.equal (Just "MiN_1_Øse")
            , test "no emojis" <| \_ ->
                ModuleName.fromString "Hey🫵"
                    |> Expect.equal Nothing
            , test "unicode Lt" <| \_ ->
                ModuleName.fromString "ǅa"
                    |> Maybe.map ModuleName.toString
                    |> Expect.equal (Just "ǅa")
            , test "valid nested name" <| \{} ->
                ModuleName.fromString "My.Nested.Module"
                    |> Maybe.map ModuleName.toString
                    |> Expect.equal (Just "My.Nested.Module")
            , test "name must be capitalized" <| \{} ->
                ModuleName.fromString "myModule"
                    |> Expect.equal Nothing
            , test "name cannot contain whitespace" <| \{} ->
                ModuleName.fromString "My Module"
                    |> Expect.equal Nothing
            , test "name cannot start with digit" <| \{} ->
                ModuleName.fromString "9Modules"
                    |> Expect.equal Nothing
            , test "nested name must be capitalized" <| \{} ->
                ModuleName.fromString "My.module"
                    |> Expect.equal Nothing
            , test "nested name cannot contain whitespace" <| \{} ->
                ModuleName.fromString "My. Module"
                    |> Expect.equal Nothing
            , test "nested name cannot start with digit" <| \{} ->
                ModuleName.fromString "My.9odule"
                    |> Expect.equal Nothing
            , test "Cannot contain $" <| \{} ->
                 ModuleName.fromString "My$9odule"
                     |> Expect.equal Nothing
            ]
         , test "withParam" <| \{} ->
             Maybe.map2
                 (\first second -> ModuleName.withParameter second first)
                 (ModuleName.fromString "Test")
                 (ModuleName.fromString "Param")
                 |> Maybe.map (ModuleName.toString)
                 |> Maybe.withDefault "Invalid"
                 |> Expect.equal "Test$$Param"
        ]
