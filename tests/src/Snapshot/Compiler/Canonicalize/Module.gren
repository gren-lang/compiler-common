module Snapshot.Compiler.Canonicalize.Module exposing (tests)

import Snapshot exposing (describe, test)
import String.Parser.Advanced as Parser
import Compiler.Canonicalize.Module as Canonicalize exposing (SourceModule, Error(..))
import Compiler.Ast.Source as ParseAst
import Compiler.Ast.Canonical as CanonicalAst
import Compiler.Parse.Context exposing (Context)
import Compiler.PackageName as PackageName
import Compiler.Parse.Module as ModParser
import Compiler.ModuleName as ModuleName
import Compiler.SourcePosition as SourcePosition exposing (Position, Region, Located, at)
import Compiler.PackageName as PackageName exposing (PackageName)
import Compiler.Parse.Module as ParseModule
import Compiler.Parse.Context as Context exposing (Context)
import Compiler.Parse.Number as Number
import Dict exposing (Dict)
import String.Parser.Advanced as Parser
import Test.Runner.Effectful as Effectful


tests : Snapshot.Test
tests =
    describe "Canonicalize.Module"
        [ describe "Values"
            [ test "Single" <| \_ ->
                canonicalize
                    [ { package = PackageName.example
                      , source =
                        """
                        module MyModule exposing (..)

                        x = 42
                        """
                      }
                    ]
                    |> Snapshot.this
            , test "Multiple" <| \_ ->
                canonicalize
                    [ { package = PackageName.example
                      , source =
                        """
                        module MyBigModule exposing (..)

                        x = 42

                        y = x
                        """
                      }
                    ]
                    |> Snapshot.this
            , test "Reference to other module" <| \_ ->
                canonicalize
                    [ { package = PackageName.example
                      , source =
                        """
                        module ModuleOne exposing (..)

                        x = 42
                        """
                      }
                    , { package = PackageName.example
                      , source =
                        """
                        module ModuleTwo exposing (..)

                        import ModuleOne

                        y = ModuleOne.x
                        """
                      }
                    ]
                    |> Snapshot.this
            , test "Reference exposed value in other module" <| \_ ->
                canonicalize
                    [ { package = PackageName.example
                      , source =
                        """
                        module ModuleOne exposing (..)

                        x = 42
                        """
                      }
                    , { package = PackageName.example
                      , source =
                        """
                        module ModuleTwo exposing (..)

                        import ModuleOne exposing (x)

                        y = x
                        """
                      }
                    ]
                    |> Snapshot.this
            ]
        , describe "Custom types"
            [ test "Intra module" <| \_ ->
                canonicalize
                    [ { package = PackageName.example
                      , source =
                        """
                        module MyModule exposing (..)

                        type Maybe a
                            = Just a
                            | Nothing

                        x = Just 42
                        """
                      }
                    ]
                    |> Snapshot.this
            , test "Exposed" <| \_ ->
                -- TODO: errors (only type is exposed, not exposed)
                canonicalize
                    [ { package = PackageName.example
                      , source =
                        """
                        module MyModule exposing (..)

                        type Maybe a
                            = Just a
                            | Nothing
                        """
                      }
                    , { package = PackageName.example
                      , source =
                        """
                        module Main exposing (..)

                        import MyModule exposing (..)

                        x = Just 5
                        """
                      }
                    ]
                    |> Snapshot.this
            ]
        , describe "Type aliases"
            [ test "Intra module" <| \_ ->
                canonicalize
                    [ { package = PackageName.example
                      , source =
                        """
                        module MyModule exposing (..)

                        type alias Person = { name : str }
                        """
                      }
                    ]
                    |> Snapshot.this
            ]
        , describe "Binops"
            [ test "Intra module" <| \_ ->
                canonicalize
                    [ { package = PackageName.example
                      , source =
                        """
                        module Math exposing (..)

                        infix left 6 (+) = add

                        add a b = 0

                        unrelated = 5 + 10 + 15
                        """
                      }
                    ]
                    |> Snapshot.this
            ]
        , describe "Parametric modules"
            [ test "Declaration" <| \_ ->
                canonicalize
                    [ { package = PackageName.example
                      , source =
                        """
                        signature module Equatable

                        type T

                        equals : T -> T -> {}
                        """
                      }
                    , { package = PackageName.example
                      , source =
                        """
                        module EqualsDelegate exposing (..)

                        require Equatable

                        isEqual = Equatable.equals
                        """
                      }
                    ]
                    |> Snapshot.this
            , test "Application" <| \_ ->
                canonicalize
                    [ { package = PackageName.example
                      , source =
                        """
                        signature module Equatable

                        type T

                        equals : T -> T -> {}
                        """
                      }
                    , { package = PackageName.example
                      , source =
                        """
                        module EqualsDelegate exposing (..)

                        require Equatable as E

                        isEqual = E.equals
                        """
                      }
                    , { package = PackageName.example
                      , source =
                        """
                        module MyType exposing (..)

                        type alias T = {}

                        equals l r = {}
                        """
                      }
                    , { package = PackageName.example
                      , source =
                        """
                        module Application exposing (..)

                        import EqualsDelegate MyType as MyEquals

                        isEqual = MyEquals.isEqual
                        """
                      }
                    ]
                    |> Snapshot.this
            ]
        ]


canonicalize : Array { package : PackageName, source : String } -> Result (Array String) Canonicalize.Context
canonicalize sources =
    sources
        |> Array.map parseModule
        |> Result.allOk
        |> Result.map
            (\mods ->
                Array.foldl
                    (\mod dict -> Dict.set (ModuleName.toString (ParseAst.moduleName mod.ast).value) mod dict )
                    Dict.empty
                    mods
            )
        |> Result.andThen canonicalizeModules


parseModule : { package : PackageName, source : String } -> Result String { package : PackageName, ast : ParseAst.Module }
parseModule mod =
    when Parser.run (ModParser.parser mod.package) Context.empty mod.source is
        Ok parsedSource ->
            Ok
                { package = mod.package
                , ast = parsedSource
                }

        Err errs ->
            Err <| ModParser.errorsToString mod.source errs


canonicalizeModules : Dict String Canonicalize.SourceModule -> Result (Array String) Canonicalize.Context
canonicalizeModules parsedMods =
    when Canonicalize.canonicalize PackageName.example parsedMods Canonicalize.emptyContext is
        Err canErrs ->
            Err [ Debug.toString canErrs ]

        Ok mods ->
            Ok mods
