module SnapshotMain exposing (..)

import Node
import Init
import Expect
import FileSystem
import FileSystem.Path as Path
import Test.Runner.Effectful as Effectful exposing (run, describe, test, await)
import Snapshot
import Snapshot.Compiler.Parse.Module
import Snapshot.Compiler.Canonicalize.Module


main : Effectful.Program a
main =
    Node.defineSimpleProgram <| \env ->
        Init.await FileSystem.initialize <| \fsPerm->
            run env <|
                Snapshot.suite
                    { filesystemPermission = fsPerm
                    , folder = Path.fromPosixString "./snapshots"
                    -- TODO: Make this a CLI flag
                    , record = True
                    }
                    [ Snapshot.Compiler.Parse.Module.tests
                    , Snapshot.Compiler.Canonicalize.Module.tests
                    ]
