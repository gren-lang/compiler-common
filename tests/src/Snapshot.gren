module Snapshot exposing
    ( Config
    , suite
    --
    , Test
    , describe
    , test
    --
    , Snapshot
    , this
    )


import Bytes
import FileSystem
import FileSystem.Path as Path exposing (Path)
import Test.Runner.Effectful as Effectful
import Expect
import UnifiedDiff



type alias Config =
    { filesystemPermission : FileSystem.Permission
    , folder : Path
    , record : Bool
    }


type alias InternalConfig =
    { filesystemPermission : FileSystem.Permission
    , folder : Path
    , namePrefix : String
    , update : Bool
    }


type Test
    = Describe { name : String, tests : Array Test }
    | Test { name : String, thunk : {} -> Snapshot }


type Snapshot
    = Snapshot String


suite : Config -> Array Test -> Effectful.Test
suite config tests =
    Effectful.concat <|
        Array.map
            (\t ->
                resolve
                    { filesystemPermission = config.filesystemPermission
                    , folder = config.folder
                    , namePrefix = "Suite"
                    , update = config.record
                    }
                    t
            )
            tests
    

resolve : InternalConfig -> Test -> Effectful.Test
resolve config test_ =
    when test_ is
        Describe { name, tests } ->
            Effectful.describe name <|
                Array.map
                    (\t ->
                        resolve
                            { filesystemPermission = config.filesystemPermission
                            , folder = config.folder
                            , namePrefix = config.namePrefix ++ "_" ++ name
                            , update = config.update
                            }
                            t
                    )
                    tests
    
        Test { name, thunk } ->
            let
                snapshotPath =
                    config.namePrefix ++ "_" ++ name
                        |> String.toLower
                        |> String.map
                            (\char ->
                                if Char.isAlphaNum char then
                                    char
                                else
                                    '_'
                            )
                        |> String.append ".snapshot"
                        |> Path.fromPosixString
                        |> Path.prepend config.folder

                (Snapshot actual) =
                    thunk {}
            in
            if config.update then
                Effectful.await
                    ("Saving snapshot for \"" ++ name ++ "\"")
                    (FileSystem.writeFile config.filesystemPermission (Bytes.fromString actual) snapshotPath)
                    <| \_ ->
                        Effectful.test name <| \_ ->
                            Expect.pass

            else
                Effectful.await
                    ("Loading snapshot for \"" ++ name ++ "\"")
                    (FileSystem.readFile config.filesystemPermission snapshotPath)
                    <| \previousSnapshotBytes ->
                        let
                            previous =
                                Bytes.toString previousSnapshotBytes
                                    |> Maybe.withDefault " "
                        in
                        Effectful.test name <| \_ ->
                            (Expect.equal previous actual
                                |> Expect.onFail (UnifiedDiff.unifiedDiffStrings previous actual)
                            )


describe : String -> Array Test -> Test
describe name tests =
    Describe { name = name, tests = tests }


test : String -> ({} -> Snapshot) -> Test
test name thunk =
    Test { name = name, thunk = thunk }


this : a -> Snapshot
this val =
    Snapshot (toStringPretty val)


-- Inspired by: https://gist.github.com/roine/604e46a40cb6e4ae144533fbeb1aef2f
toStringPretty : a -> String
toStringPretty val =
    val
        |> Debug.toString
        |> formatString False 0


quote : String
quote =
    "\""


indentChars : String
indentChars =
    "[{("


outdentChars : String
outdentChars =
    "}])"


newLineChars : String
newLineChars =
    ","


incr : Int
incr =
    4


formatString : Bool -> Int -> String -> String
formatString isInQuotes indent str =
    when String.takeFirst 1 str is
        "" ->
            ""

        firstChar ->
            if isInQuotes then
                if firstChar == quote then
                    firstChar
                        ++ formatString (not isInQuotes) indent (String.dropFirst 1 str)

                else
                    firstChar
                        ++ formatString isInQuotes indent (String.dropFirst 1 str)

            else if String.contains firstChar newLineChars then
                "\n"
                    ++ String.repeat indent " "
                    ++ firstChar
                    ++ formatString isInQuotes indent (String.dropFirst 1 str)

            else if String.contains firstChar indentChars then
                "\n"
                    ++ String.repeat (indent + incr) " "
                    ++ firstChar
                    ++ formatString isInQuotes (indent + incr) (String.dropFirst 1 str)

            else if String.contains firstChar outdentChars then
                "\n"
                    ++ String.repeat indent " "
                    ++ firstChar
                    ++ formatString isInQuotes (indent - incr) (String.dropFirst 1 str)

            else if firstChar == quote then
                firstChar
                    ++ formatString (not isInQuotes) indent (String.dropFirst 1 str)

            else
                firstChar
                    ++ formatString isInQuotes indent (String.dropFirst 1 str)
