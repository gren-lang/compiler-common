module Compiler.ModuleName exposing
    ( ModuleName
    , withParameter
    , fromString
    , jsonDecoder
    , toString
    , toJson
    --
    , basics
    , bytes
    , string
    , jsonEncode
    , maybe
    , array
    , cmd
    , sub
    )


{-| A module for working with Gren module names.

@docs ModuleName

## Conversions

@docs fromString, jsonDecoder

## Conversions

@docs toString, toJson
-}

import Json.Decode as Decode exposing (Decoder)
import Json.Encode as Encode


{-| A valid module name like `Module.Name`.
-}
type ModuleName
    = ModuleName String


{-| Construct a [ModuleName](#ModuleName) from a `String`. Will return `Nothing`
if the `String` doesn't represent a valid module name.
-}
fromString : String -> Maybe ModuleName
fromString str =
    let
        sections =
            String.split "." str

        sectionTest section =
            when String.popFirst section is
                Just { first, rest } ->
                    Char.isUpper first && String.all Char.isAlphaNum rest

                Nothing ->
                    False
    in
    if Array.all sectionTest sections then
        Just <| ModuleName str

    else
        Nothing


{-| Combines two [ModuleName](#ModuleName)s to represent that the first is a parameter of the second.

    Maybe.map2
        (\first second -> ModuleName.withParameter second first)
        (ModuleName.fromString "Test")
        (ModuleName.fromString "Param")
        |> Maybe.map (ModuleName.toString)
        |> Maybe.withDefault "Invalid"
        == "Test$$Param"
-}
withParameter : ModuleName -> ModuleName -> ModuleName
withParameter (ModuleName param) (ModuleName base) =
    ModuleName (base ++ "$$" ++ param)


{-| JSON Decoder for [ModuleName](#ModuleName).
-}
jsonDecoder : Decoder ModuleName
jsonDecoder =
    Decode.string
        |> Decode.andThen
            (\str ->
                when fromString str is
                    Just moduleName ->
                        Decode.succeed moduleName

                    Nothing ->
                        Decode.fail ("Not a valid module name: " ++ str)
            )


{-| `String` representation for [ModuleName](#ModuleName).
-}
toString : ModuleName -> String
toString (ModuleName name) =
    name


{-| JSON Encoder for [ModuleName](#ModuleName).
-}
toJson : ModuleName -> Encode.Value
toJson moduleName =
    Encode.string (toString moduleName)


-- NAMES

basics : ModuleName
basics =
    ModuleName "Basics"


bytes : ModuleName
bytes =
    ModuleName "Bytes"


jsonEncode : ModuleName
jsonEncode =
    ModuleName "Json.Encode"


string : ModuleName
string =
    ModuleName "String"


maybe : ModuleName
maybe =
    ModuleName "Maybe"


array : ModuleName
array =
    ModuleName "Array"


cmd : ModuleName
cmd =
    ModuleName "Platform.Cmd"


sub : ModuleName
sub =
    ModuleName "Platform.Sub"
