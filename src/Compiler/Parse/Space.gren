module Compiler.Parse.Space exposing
    ( Error (..)
    , parser
    , scopeIndentToLineStart
    , scopeIndentToLineStartPlus1
    , scopeIndentToCurrentColumn
    , checkIndent
    , checkIndentAtLeastEqual
    , checkIndentExact
    , checkStartOfLine
    , errorToString
    )


{-| This module provides parsers for whitespace and comments in Gren code.

@docs parser, Error, errorToString

## Indentation helpers

@docs scopeIndentToLineStart, scopeIndentToLineStartPlus1, scopeIndentToCurrentColumn, checkIndent, checkIndentAtLeastEqual, checkIndentExact, checkStartOfLine
-}


import Compiler.Parse.Context as Context exposing (Context)
import String.Parser.Advanced as Parser exposing (Parser)
import Dict
import Compiler.SourcePosition as SourcePosition
import Array.Builder


{-| The kind of errors that can happen while parsing whitespace and comments.
-}
type Error
    = ExpectedLineComment
    | ExpectedMultiLineOpen
    | ExpectedMultiLineClose
    | InvalidWhiteSpace


{-| Returns a human-readable description of an `Error`.
-}
errorToString : Error -> String
errorToString error =
    when error is
        ExpectedLineComment ->
            "Expected line comment"

        ExpectedMultiLineOpen ->
            "Expected {-"

        ExpectedMultiLineClose ->
            "Expected -}"
        
        InvalidWhiteSpace ->
            "Invalid whitespace character"


{-| Use this to parse whitespace and comments.
This will change `lineStart` and `comments` fields of `Context`.

    String.Parser.run parser Compiler.Parse.Context.empty source
-}
parser : Parser Context Error {}
parser =
    Parser.getPosition
        |> Parser.andThen
            (\startPos ->
                Parser.loop { start = startPos, candidate = startPos } parseLoop
            )


type alias LoopState =
    { start : SourcePosition.Position
    , candidate : SourcePosition.Position
    }


parseLoop : LoopState -> Parser Context Error (Parser.Step LoopState {})
parseLoop state =
    Parser.oneOf
        [ Parser.succeed
            (\start comment end ->
                comment
                    |> String.sliceUnits 2 (String.unitLength comment)
                    |> Context.Line
                    |> SourcePosition.at start end
            )
            |> Parser.keep Parser.getPosition
            |> Parser.keep (Parser.getChompedString <| Parser.lineComment "--" ExpectedLineComment)
            |> Parser.keep Parser.getPosition
            |> Parser.andThen
                (\value ->
                    Parser.succeed (Parser.Loop <| parseLoopCalcPos state value.start)
                        |> Parser.updatePayload (\pl -> { pl | comments = Array.Builder.pushLast value pl.comments })
                )
        , Parser.succeed
            (\start comment end ->
                comment
                    |> String.sliceUnits 2 -2
                    |> Context.Block
                    |> SourcePosition.at start end
            )
            |> Parser.keep Parser.getPosition
            |> Parser.skip
                (Parser.oneOf
                    [ Parser.token "{-|" ExpectedMultiLineOpen
                        |> Parser.andThen (\_ -> Parser.problem ExpectedMultiLineOpen)
                    , Parser.succeed {}
                    ]
                    |> Parser.backtrackable
                )
            |> Parser.keep
                (Parser.multiComment
                    { string = "{-", expecting = ExpectedMultiLineOpen }
                    { string = "-}", expecting = ExpectedMultiLineClose }
                    Parser.Nestable
                    |> Parser.getChompedString
                )
            |> Parser.keep Parser.getPosition
            |> Parser.andThen
                (\value ->
                    Parser.succeed (Parser.Loop <| parseLoopCalcPos state value.start)
                        |> Parser.updatePayload (\pl -> { pl | comments = Array.Builder.pushLast value pl.comments })
                )
        , Parser.succeed (Parser.Loop state)
            |> Parser.skip (Parser.chompIf validWhiteSpace InvalidWhiteSpace)
            |> Parser.skip (Parser.chompWhile validWhiteSpace)
        , Parser.getPosition
            |> Parser.andThen
                (\currentPos ->
                    let
                        { start, candidate } =
                            parseLoopCalcPos state currentPos
                    in
                    if start.row /= candidate.row || start.col == 1 then
                        Parser.succeed (Parser.Done {})
                            |> Parser.updatePayload (\pl -> { pl | lineStart = candidate.col })

                    else
                        Parser.succeed (Parser.Done {})
                )
        ]


parseLoopCalcPos : LoopState -> SourcePosition.Position -> LoopState
parseLoopCalcPos state newPos =
    if state.candidate.row /= newPos.row || state.candidate.col == 1 then
        { start = state.start, candidate = newPos }

    else
        state


validWhiteSpace : Char -> Bool
validWhiteSpace char =
    char == ' ' || char == '\n' || char == '\r'


{-| This will set `Context.indent` to be ´Context.startLine` for the duration of
the provided parser.
-}
scopeIndentToLineStart : Parser Context e v -> Parser Context e v
scopeIndentToLineStart p =
    Parser.scopedUpdatePayload
        .lineStart
        .indent
        (\newIndent payload -> { payload | indent = newIndent })
        p


{-| This will set `Context.indent` to be ´Context.startLine + 1` for the duration of
the provided parser. Helpful when you want something to be indented at least one space
on the proceeding lines.
-}
scopeIndentToLineStartPlus1 : Parser Context e v -> Parser Context e v
scopeIndentToLineStartPlus1 p =
    Parser.scopedUpdatePayload
        (\ctx -> ctx.lineStart + 1)
        .indent
        (\newIndent payload -> { payload | indent = newIndent })
        p


{-| This will set `Context.indent` to the current column for the duration of
the provided parser.
-}
scopeIndentToCurrentColumn : Parser Context e v -> Parser Context e v
scopeIndentToCurrentColumn p =
    Parser.getCol
        |> Parser.andThen
            (\col ->
                Parser.scopedUpdatePayload
                    (\_ -> col)
                    .indent
                    (\newIndent payload -> { payload | indent = newIndent })
                    p
            )
    

{-| Use this to check that the current indentation is valid. That is, the current
column has to be _greater_ than `Context.indent`.

This allows you to stop parsing when the indentation level decreases.
-}
checkIndent : Parser Context {} {}
checkIndent =
    checkIndentHelper (\indent col -> col > indent)


checkIndentHelper : (Int -> Int -> Bool) -> Parser Context {} {}
checkIndentHelper check =
    Parser.succeed (\indent col -> { indent = indent, col = col })
        |> Parser.keep (Parser.map .indent Parser.getPayload)
        |> Parser.keep Parser.getCol
        |> Parser.andThen
            (\{ indent, col } ->
                if check indent col then
                    Parser.succeed {}

                else
                    Parser.problem {}
            )


{-| Same as `checkIndent` but additionally accepts an indentation _equal_ to the
set indentation level
-}
checkIndentAtLeastEqual : Parser Context {} {}
checkIndentAtLeastEqual =
    checkIndentHelper (\indent col -> col >= indent && col > 1)


{-| Checks if the indent is _exactly_ the set indentation level
-}
checkIndentExact : Parser Context {} {}
checkIndentExact =
    checkIndentHelper (\indent col -> col == indent)


{-| Check that we're at the start of a line
-}
checkStartOfLine : err -> Parser Context err {}
checkStartOfLine err =
    Parser.getCol
        |> Parser.andThen
            (\ col ->
                if col == 1 then
                    Parser.succeed {}

                else
                    Parser.problem err
            )
