module Compiler.Parse.Pattern exposing
    ( Error (..)
    , parser
    , parserNoAlias
    , topLevelParser
    , aliasTopLevelParser
    , errorToString
    )


{-| This module provides parsers for Gren patterns.

@docs parser, parserNoAlias, topLevelParser, aliasTopLevelParser, Error, errorToString
-}


import String.Parser.Advanced as Parser exposing (Parser)
import Array.Builder as Builder exposing (Builder)
import Compiler.Ast.Source as AST
import Compiler.SourcePosition as SourcePosition
import Compiler.Parse.Number as Number
import Compiler.Parse.String as String
import Compiler.Parse.Space as Space
import Compiler.Parse.Variable as Variable
import Compiler.Parse.Number as Number
import Compiler.Parse.Context exposing (Context)


{-| The kind of errors that can happen while parsing patterns.
-}
type Error
    = ExpectedChar Char
    | ExpectedKeyword String
    | VariableError Variable.Error
    | NumberError Number.Error
    | FloatNotSupported
    | StringError String.Error
    | SpaceError Space.Error


{-| Returns a human-readable description of an `Error`.
-}
errorToString : Error -> String
errorToString error =
    when error is
        ExpectedChar char ->
            "Expected character '" ++ String.fromChar char ++ "'"
        
        ExpectedKeyword keyword ->
            "Expected keyword '" ++ keyword ++ "'"
        
        VariableError varError ->
            Variable.errorToString varError
        
        NumberError numError ->
            Number.errorToString numError
        
        FloatNotSupported ->
            "Float patterns are not supported"
        
        StringError strError ->
            String.errorToString strError
        
        SpaceError spaceError ->
            Space.errorToString spaceError


{-| Use this to parse patterns.

    String.Parser.run parser Compiler.Parse.Context.empty source
-}
parser : Parser Context Error AST.Pattern
parser =
    Parser.succeed
        (\pattern alias ->
            when alias is
                Just name ->
                    SourcePosition.at
                        pattern.start
                        name.end
                        (AST.PAlias { pattern = pattern, name = name })

                Nothing ->
                    pattern
        )
        |> Parser.keep parserNoAlias
        |> Parser.skip spaceParser
        |> Parser.keep
            (Parser.oneOf
                [ Parser.succeed Just
                    |> Parser.skip (Parser.keyword "as" (ExpectedKeyword "as"))
                    |> Parser.skip spaceParser
                    |> Parser.keep (SourcePosition.parser lowerCaseVariable)
                , Parser.succeed Nothing
                ]
            )


{-| Same as `parser`, but doesn't look for the `as` keyword following the pattern
-}
parserNoAlias : Parser Context Error AST.Pattern
parserNoAlias =
    Parser.oneOf
        [ record
        , array
        , parenthesized
        , term
        ]


record : Parser Context Error AST.Pattern
record =
    Parser.succeed (\start fields end -> SourcePosition.at start end (AST.PRecord fields))
        |> Parser.keep Parser.getPosition
        |> Parser.skip (Parser.chompChar '{' (ExpectedChar '{'))
        |> Parser.skip spaceParser
        |> Parser.keep (Parser.loop (Builder.empty 0) recordInnerLoop)
        |> Parser.keep Parser.getPosition


recordInnerLoop : Builder AST.PRecordField -> Parser Context Error (Parser.Step (Builder AST.PRecordField) (Array AST.PRecordField))
recordInnerLoop acc =
    Parser.oneOf
        [ Parser.succeed acc
            |> Parser.skip (Parser.chompChar '}' (ExpectedChar '}'))
            |> Parser.map (\a -> Parser.Done <| Builder.toArray a)
        , Parser.succeed (\start fieldName end -> SourcePosition.at start end fieldName)
            |> Parser.keep Parser.getPosition
            |> Parser.keep lowerCaseVariable
            |> Parser.keep Parser.getPosition
            |> Parser.skip spaceParser
            |> Parser.andThen
                (\field ->
                    Parser.oneOf
                        [ Parser.succeed acc
                            |> Parser.skip (Parser.chompChar '}' (ExpectedChar '}'))
                            |> Parser.map (\a -> Parser.Done <| Builder.toArray <| Builder.pushLast { field = field, pattern = Nothing } a)
                        , Parser.succeed (Parser.Loop <| Builder.pushLast { field = field, pattern = Nothing } acc)
                            |> Parser.skip (Parser.chompChar ',' (ExpectedChar ','))
                            |> Parser.skip spaceParser
                        , Parser.succeed identity
                            |> Parser.skip (Parser.chompChar '=' (ExpectedChar '='))
                            |> Parser.skip spaceParser
                            |> Parser.keep topLevelParser
                            |> Parser.skip spaceParser
                            |> Parser.andThen
                                (\pattern ->
                                    Parser.oneOf
                                        [ Parser.succeed (Parser.Loop <| Builder.pushLast { field = field, pattern = Just pattern } acc)
                                            |> Parser.skip (Parser.chompChar ',' (ExpectedChar ','))
                                            |> Parser.skip spaceParser
                                        , Parser.succeed acc
                                            |> Parser.skip (Parser.chompChar '}' (ExpectedChar '}'))
                                            |> Parser.map (\a -> Parser.Done <| Builder.toArray <| Builder.pushLast { field = field, pattern = Just pattern } a)
                                        ]
                                )
                        ]
                )
        ]


array : Parser Context Error AST.Pattern
array =
    Parser.succeed (\start arr end -> SourcePosition.at start end (AST.PArray arr))
        |> Parser.keep Parser.getPosition
        |> Parser.skip (Parser.chompChar '[' (ExpectedChar '['))
        |> Parser.skip spaceParser
        |> Parser.keep
            ( Parser.oneOf
                [ Parser.lazy (\_ -> topLevelParser)
                    |> Parser.skip spaceParser
                    |> Parser.andThen (\firstArg -> Parser.loop (Builder.pushLast firstArg (Builder.empty 1) ) arrayInnerLoop)
                , Parser.succeed []
                    |> Parser.skip (Parser.chompChar ']' (ExpectedChar ']'))
                ]
            )
        |> Parser.keep Parser.getPosition


arrayInnerLoop : Builder AST.Pattern -> Parser Context Error (Parser.Step (Builder AST.Pattern) (Array AST.Pattern))
arrayInnerLoop acc =
    Parser.oneOf
        [ Parser.succeed acc
            |> Parser.skip (Parser.chompChar ']' (ExpectedChar ']'))
            |> Parser.map (\a -> Parser.Done <| Builder.toArray a)
        , Parser.succeed (\expr -> Parser.Loop (Builder.pushLast expr acc))
            |> Parser.skip (Parser.chompChar ',' (ExpectedChar ','))
            |> Parser.skip spaceParser
            |> Parser.keep topLevelParser
            |> Parser.skip spaceParser
        ]


parenthesized : Parser Context Error AST.Pattern
parenthesized =
    Parser.succeed identity
        |> Parser.skip (Parser.chompChar '(' (ExpectedChar '('))
        |> Parser.skip spaceParser
        |> Parser.keep topLevelParser
        |> Parser.skip spaceParser
        |> Parser.skip (Parser.chompChar ')' (ExpectedChar ')'))


{-| Use this parser when you know that you're expecting exactly one pattern, as opposed
to _one or more_ patterns. As an example: this parser will treat `MyCtor one` as one pattern,
not two.
-}
topLevelParser : Parser Context Error AST.Pattern
topLevelParser =
    (Parser.oneOf
        [ SourcePosition.parser (numberBy Number.parser)
        , Parser.succeed (\var arg -> { ctor = var, arg = arg })
            |> Parser.keep (SourcePosition.parser (Parser.mapError VariableError Variable.foreignUpper))
            |> Parser.skip spaceParser
            |> Parser.keep
                (Parser.oneOf
                    [ Parser.succeed Just
                        |> Parser.keep (Parser.lazy (\_ -> parserNoAlias))
                    , Parser.succeed Nothing
                    ]
                )
            |> Parser.map
                (\{ ctor = { start, end, value }, arg } ->
                    when value is
                        Variable.Unqualified ctor ->
                            SourcePosition.at
                                start
                                (Maybe.withDefault end (Maybe.map .end arg))
                                (AST.PCtor
                                    { name = SourcePosition.at start end ctor
                                    , arg = arg
                                    }
                                )

                        Variable.Qualified { module_, name } ->
                            SourcePosition.at
                                start
                                (Maybe.withDefault end (Maybe.map .end arg))
                                (AST.PCtorQual
                                    { varRegion = { start = start, end = end }
                                    , module_ = module_
                                    , name = name
                                    , arg = arg
                                    }
                                )
                )
        , Parser.lazy (\_ -> parser)
        ]
    )


{-| Use this when you want a topLevelParser that accepts aliases with the `as` keyword.

    String.Parser.run parser Compiler.Parse.Context.empty source
-}
aliasTopLevelParser : Parser Context Error AST.Pattern
aliasTopLevelParser =
    Parser.succeed
        (\pattern alias ->
            when alias is
                Just name ->
                    SourcePosition.at
                        pattern.start
                        name.end
                        (AST.PAlias { pattern = pattern, name = name })

                Nothing ->
                    pattern
        )
        |> Parser.keep topLevelParser
        |> Parser.skip spaceParser
        |> Parser.keep
            (Parser.oneOf
                [ Parser.succeed Just
                    |> Parser.skip (Parser.keyword "as" (ExpectedKeyword "as"))
                    |> Parser.skip spaceParser
                    |> Parser.keep (SourcePosition.parser lowerCaseVariable)
                , Parser.succeed Nothing
                ]
            )


term : Parser Context Error AST.Pattern
term =
    Parser.succeed (\start expr end -> SourcePosition.at start end expr)
        |> Parser.keep Parser.getPosition
        |> Parser.keep
            ( Parser.oneOf
                [ Parser.succeed (\name -> AST.PAnything name)
                    |> Parser.skip (Parser.chompChar '_' (ExpectedChar '_'))
                    |> Parser.keep
                        (Parser.oneOf
                            [ lowerCaseVariable
                            , Parser.succeed ""
                            ]
                        )
                , lowerCaseVariable
                    |> Parser.map AST.PVar
                , SourcePosition.parser (Parser.mapError VariableError Variable.foreignUpper)
                    |> Parser.map
                        (\{ start, end, value } ->
                            when value is
                                Variable.Unqualified ctor ->
                                    AST.PCtor
                                        { name = SourcePosition.at start end ctor
                                        , arg = Nothing
                                        }

                                Variable.Qualified { module_, name } ->
                                    AST.PCtorQual
                                        { varRegion = { start = start, end = end }
                                        , module_ = module_
                                        , name = name
                                        , arg = Nothing
                                        }
                        )
                , numberBy Number.zeroOrHigher
                , String.string
                    |> Parser.mapError StringError
                    |> Parser.map AST.PStr
                , String.char
                    |> Parser.mapError StringError
                    |> Parser.map AST.PChr
                ]
            )
        |> Parser.keep Parser.getPosition


spaceParser : Parser Context Error {}
spaceParser =
    Parser.mapError SpaceError Space.parser


lowerCaseVariable : Parser Context Error String
lowerCaseVariable =
    Parser.mapError VariableError Variable.lowerCase


numberBy : Parser Context Number.Error Number.Outcome -> Parser Context Error AST.Pattern_
numberBy numParser =
    numParser
        |> Parser.mapError NumberError
        |> Parser.andThen
            (\num ->
                when num is
                    Number.Integer int ->
                        Parser.succeed <| AST.PInt { isHex = False, value = int }

                    Number.Hex int ->
                        Parser.succeed <| AST.PInt { isHex = True, value = int }

                    Number.FloatingPoint _ ->
                        Parser.problem FloatNotSupported
            )
