module Compiler.Parse.Expression exposing
    ( Error (..)
    , parser
    , letDefNamedParser
    , errorToString
    )


{-| This module provides parsers for Gren expressions.

@docs parser, Error, errorToString, letDefNamedParser
-}


import String.Parser.Advanced as Parser exposing (Parser)
import Array.Builder as Builder exposing (Builder)
import Compiler.Ast.Source as AST
import Compiler.SourcePosition as SourcePosition
import Compiler.Parse.Number as Number
import Compiler.Parse.Operator as Operator
import Compiler.Parse.String as String
import Compiler.Parse.Space as Space
import Compiler.Parse.Variable as Variable
import Compiler.Parse.Pattern as Pattern
import Compiler.Parse.Type as Type
import Set exposing (Set)
import Compiler.Parse.Context exposing (Context)


{-| The kind of errors that can happen while parsing expressions.
-}
type Error
    = ExpectedChar Char
    | ExpectedKeyword String
    | VariableError Variable.Error
    | NumberError Number.Error
    | StringError String.Error
    | PatternError Pattern.Error
    | TypeError Type.Error
    | WildcardAttempt
    | ExpectedLowerVariable AST.Expression
    | NameMismatch { first : String, second : String }
    | IndentError
    | BadOperator String
    | InvalidOperatorChar
    | SpaceError Space.Error
    | OperatorError Operator.Error
    | InternalError


{-| Returns a human-readable description of an `Error`.
-}
errorToString : Error -> String
errorToString error =
    when error is
        ExpectedChar char ->
            "Expected character '" ++ String.fromChar char ++ "'"
        
        ExpectedKeyword keyword ->
            "Expected keyword '" ++ keyword ++ "'"
        
        VariableError varError ->
            Variable.errorToString varError
        
        NumberError numError ->
            Number.errorToString numError
        
        StringError strError ->
            String.errorToString strError
        
        PatternError patError ->
            Pattern.errorToString patError
        
        TypeError typeError ->
            Type.errorToString typeError
        
        WildcardAttempt ->
            "Wildcard patterns are not allowed in expressions"
        
        ExpectedLowerVariable _ ->
            "Expected lower case variable"
        
        NameMismatch { first, second } ->
            "Name mismatch: expected '" ++ first ++ "' but got '" ++ second ++ "'"
        
        IndentError ->
            "Indentation error"
        
        BadOperator op ->
            "Invalid operator: '" ++ op ++ "'"
        
        InvalidOperatorChar ->
            "Invalid operator character"
        
        SpaceError spaceError ->
            Space.errorToString spaceError
        
        OperatorError opError ->
            Operator.errorToString opError
        
        InternalError ->
            "Internal parser error"


{-| Use this to parse expressions.

    String.Parser.run parser Compiler.Parse.Context.empty source
-}
parser : Parser Context Error AST.Expression
parser =
    parserNoArgs
        |> Parser.andThen
            (\firstTerm ->
                let
                    completionParser =
                        Parser.succeed identity
                            |> Parser.skip spaceParser
                            |> Parser.keep
                                (Parser.loop
                                    { currentTerm = firstTerm
                                    , currentArgs = Builder.empty 3
                                    , incompleteBinop = Nothing
                                    }
                                    argOrOperatorLoop
                                )
                            |> Parser.map
                                (\state ->
                                    let
                                        finalExpression =
                                            toCall state.currentTerm (Builder.toArray state.currentArgs)
                                    in
                                    when state.incompleteBinop is
                                        Just incomplete ->
                                            SourcePosition.at
                                                incomplete.left.start
                                                finalExpression.end
                                                (AST.Binops
                                                    { left = incomplete.left
                                                    , operator = incomplete.operator
                                                    , right = finalExpression
                                                    }
                                                )
                                        
                                        Nothing ->
                                            finalExpression
                                )

                    indentationBumped =
                        Space.scopeIndentToLineStart completionParser
                in
                when firstTerm.value is
                    AST.Var _ ->
                        indentationBumped

                    AST.VarQual _ ->
                        indentationBumped

                    _ ->
                        completionParser
            )


parserNoArgs : Parser Context Error AST.Expression
parserNoArgs =
    Parser.oneOf
        [ ifParser
        , whenParser
        , letParser
        , possiblyNegativeTerm
        ]


type alias ArgOrOperatorState =
    { currentTerm : AST.Expression
    , currentArgs : Builder AST.Expression
    , incompleteBinop : Maybe { left : AST.Expression, operator : SourcePosition.Located String }
    }


argOrOperatorLoop : ArgOrOperatorState -> Parser Context Error (Parser.Step ArgOrOperatorState ArgOrOperatorState)
argOrOperatorLoop state =
    Parser.oneOf
        [ Parser.succeed identity
            |> Parser.keep (SourcePosition.parser operatorParser)
            |> Parser.skip spaceParser
            |> Parser.andThen
                (\operator ->
                    if operator.value == "-" then
                        Parser.getPosition
                            |> Parser.andThen
                                (\pos ->
                                    if operator.end.col == pos.col && operator.end.row == pos.row then
                                        -- negated term (no space after operator)
                                        Parser.succeed (\term_ -> Parser.Loop <| pushStateArg (SourcePosition.at operator.start term_.end (AST.Negate term_)) state)
                                            |> Parser.skip checkIndent
                                            |> Parser.keep term

                                    else
                                        Parser.succeed (\nextTerm -> Parser.Loop <| pushStateOperator nextTerm operator state)
                                            |> Parser.keep parserNoArgs
                                )

                    else
                        Parser.succeed (\nextTerm -> Parser.Loop <| pushStateOperator nextTerm operator state)
                            |> Parser.keep parserNoArgs
                )
                |> Parser.skip spaceParser
        , Parser.succeed (\arg -> Parser.Loop <| pushStateArg arg state)
            |> Parser.skip checkIndentAtLeastEqual
            |> Parser.keep term
            |> Parser.skip spaceParser
        , Parser.succeed (Parser.Done state)
        ]


pushStateArg : AST.Expression -> ArgOrOperatorState -> ArgOrOperatorState 
pushStateArg arg state =
    { state | currentArgs = Builder.pushLast arg state.currentArgs }


pushStateOperator : AST.Expression -> SourcePosition.Located String -> ArgOrOperatorState -> ArgOrOperatorState 
pushStateOperator expr operator state =
    let
        leftExpression =
            toCall state.currentTerm (Builder.toArray state.currentArgs)
        
        binopExpression =
            SourcePosition.at
                leftExpression.start
                expr.end
                (AST.Binops
                    { left = leftExpression
                    , operator = operator
                    , right = expr
                    }
                )
    in
    when state.incompleteBinop is
        Just existingBinop ->
            { currentTerm = expr
            , currentArgs = Builder.empty 3
            , incompleteBinop =
                Just <|
                    { left =
                        SourcePosition.at
                            existingBinop.left.start
                            leftExpression.end
                            (AST.Binops
                                { left = existingBinop.left
                                , operator = existingBinop.operator
                                , right = leftExpression
                                }
                            )
                    , operator = operator
                    }
            }
        
        Nothing ->
            { currentTerm = expr
            , currentArgs = Builder.empty 3
            , incompleteBinop =
                Just
                    { left = leftExpression
                    , operator = operator
                    }
            }


toCall : AST.Expression -> Array AST.Expression -> AST.Expression
toCall fn args =
    if Array.isEmpty args then
        fn

    else
        let
            argsEnd =
                Array.last args
                    |> Maybe.map .end
                    |> Maybe.withDefault fn.end
        in
        SourcePosition.at
            fn.start
            argsEnd
            (AST.Call { fn = fn, args = args })


operatorParser : Parser Context Error String
operatorParser =
    Parser.mapError OperatorError Operator.parser
        |> Parser.backtrackable


-- LET


letParser : Parser Context Error AST.Expression
letParser =
    Parser.succeed
        (\start firstDef defs body ->
            SourcePosition.at
                start
                body.end
                (AST.Let
                    { defs = Array.pushFirst firstDef defs
                    , body = body
                    }
                )
        )
        |> Parser.keep Parser.getPosition
        |> Parser.skip (Parser.keyword "let" (ExpectedKeyword "let"))
        |> Parser.skip spaceParser
        |> Parser.keep letDefParser
        |> Parser.skip spaceParser
        |> Parser.keep (Parser.loop (Builder.empty 1) letDefLoopParser)
        |> Parser.skip spaceParser
        |> Parser.keep (Parser.lazy (\_ -> parser))


letDefParser : Parser Context Error (SourcePosition.Located AST.Def)
letDefParser =
    Parser.oneOf
        [ letDefNamedParser
            |> Parser.map (\{ start, value, end } -> SourcePosition.at start end (AST.Define value))
        , letDefDestructParser
        ]
        |> Space.scopeIndentToLineStart


{-| Use this to parse named let definitions.

    String.Parser.run letDefNamedParser Compiler.Parse.Context.empty source
-}
letDefNamedParser : Parser Context Error (SourcePosition.Located AST.DefineRecord)
letDefNamedParser =
    Parser.succeed identity
        |> Parser.keep (SourcePosition.parser lowerCaseVariable)
        |> Parser.skip spaceParser
        |> Parser.andThen
            (\var ->
                Parser.succeed
                    (\maybeSignature args body ->
                        when maybeSignature is
                            Just { tipe, realVar } ->
                                SourcePosition.at
                                    var.start
                                    body.end
                                    { name = realVar
                                    , args = args
                                    , body = body
                                    , typeSignature = Just tipe
                                    }

                            Nothing ->
                                SourcePosition.at
                                    var.start
                                    body.end
                                    { name = var
                                    , args = args
                                    , body = body
                                    , typeSignature = Nothing
                                    }
                    )
                    |> Parser.keep
                        (Parser.oneOf
                            [ Parser.succeed (\t rv -> Just { tipe = t, realVar = rv })
                                |> Parser.skip (Parser.chompChar ':' (ExpectedChar ':'))
                                |> Parser.skip spaceParser
                                |> Parser.keep
                                    (Type.expression
                                        |> Parser.mapError TypeError
                                    )
                                |> Parser.keep
                                    ( SourcePosition.parser lowerCaseVariable
                                        |> Parser.andThen
                                            (\var2 ->
                                                if var.value /= var2.value then
                                                    Parser.problem <|
                                                        NameMismatch
                                                            { first = var.value
                                                            , second = var2.value
                                                            }

                                                else
                                                    Parser.succeed var2
                                            )
                            
                                    )
                                |> Parser.skip spaceParser
                            , Parser.succeed Nothing
                            ]
                        )
                    |> Parser.scopedUpdatePayload
                        (\_ -> var.start.col)
                        .indent
                        (\nextValue payload -> { payload | indent = nextValue })
                    |> Parser.keep (Parser.loop (Builder.empty 1) (functionArgsParser "="))
                    |> Parser.skip spaceParser
                    |> Parser.skip checkIndent
                    |> Parser.keep (Space.scopeIndentToCurrentColumn (Parser.lazy (\_ -> parser)))
            )


letDefDestructParser : Parser Context Error (SourcePosition.Located AST.Def)
letDefDestructParser =
    Parser.succeed
        (\pattern body ->
            SourcePosition.at
                pattern.start
                body.end
                (AST.Destruct
                    { pattern = pattern
                    , body = body
                    }
                )
        )
        |> Parser.keep (Parser.mapError PatternError Pattern.parser)
        |> Parser.skip spaceParser
        |> Parser.skip (Parser.chompChar '=' (ExpectedChar '='))
        |> Parser.skip spaceParser
        |> Parser.keep (Parser.lazy (\_ -> parser))


letDefLoopParser : Builder (SourcePosition.Located AST.Def) -> Parser Context Error (Parser.Step (Builder (SourcePosition.Located AST.Def)) (Array (SourcePosition.Located AST.Def)))
letDefLoopParser defs =
    Parser.oneOf
        [ Parser.succeed defs
            |> Parser.skip (Parser.keyword "in" (ExpectedKeyword "in"))
            |> Parser.map (\d -> Parser.Done <| Builder.toArray d)
        , Parser.succeed (\def -> Parser.Loop <| Builder.pushLast def defs)
            |> Parser.keep letDefParser
            |> Parser.skip spaceParser
        ]


-- IF


ifParser : Parser Context Error AST.Expression
ifParser =
    Parser.succeed (\startPos firstBranch -> { startPos = startPos, firstBranch = firstBranch })
        |> Parser.keep Parser.getPosition
        |> Parser.keep ifBranchParser
        |> Parser.andThen
            (\{ startPos, firstBranch } ->
                Parser.loop (Builder.pushLast firstBranch (Builder.empty 1)) (ifElseLoop startPos)
            )


ifBranchParser : Parser Context Error AST.IfBranch
ifBranchParser =
    Parser.succeed (\test body -> { test = test, body = body })
        |> Parser.skip (Parser.keyword "if" (ExpectedKeyword "if"))
        |> Parser.skip spaceParser
        |> Parser.keep (Parser.lazy (\_ -> parser))
        |> Parser.skip spaceParser
        |> Parser.skip (Parser.keyword "then" (ExpectedKeyword "then"))
        |> Parser.skip spaceParser
        |> Parser.keep (Parser.lazy (\_ -> parser))
        |> Parser.skip spaceParser
        |> Parser.skip (Parser.keyword "else" (ExpectedKeyword "else"))
        |> Parser.skip spaceParser


ifElseLoop : { row : Int, col : Int } -> Builder AST.IfBranch -> Parser Context Error (Parser.Step (Builder AST.IfBranch) AST.Expression)
ifElseLoop startPos branches =
    Parser.oneOf
        [ Parser.succeed (\branch -> Parser.Loop (Builder.pushLast branch branches))
            |> Parser.keep ifBranchParser
        , Parser.succeed
            (\expr ->
                Parser.Done <|
                    SourcePosition.at
                        startPos
                        expr.end
                        (AST.If
                            { branches = Builder.toArray branches
                            , elseBranch = expr
                            }
                        )
            )
            |> Parser.keep parser
            |> Parser.skip spaceParser
        ]


-- WHEN IS


whenParser : Parser Context Error AST.Expression
whenParser =
    Parser.succeed (\start expr firstBranch -> { start = start, expr = expr, firstBranch = firstBranch })
        |> Parser.keep Parser.getPosition
        |> Parser.skip (Parser.keyword "when" (ExpectedKeyword "when"))
        |> Parser.skip spaceParser
        |> Parser.keep (Parser.lazy (\_ -> parser))
        |> Parser.skip spaceParser
        |> Parser.skip (Parser.keyword "is" (ExpectedKeyword "is"))
        |> Parser.skip spaceParser
        |> Parser.keep whenBranchParser
        |> Parser.andThen
            (\{ start, expr, firstBranch } ->
                Parser.loop (Builder.pushLast firstBranch (Builder.empty 1) ) whenBranchLoopParser
                    |> Parser.map
                        (\branches ->
                            let
                                endLocation =
                                    Array.last branches
                                        |> Maybe.map .body
                                        |> Maybe.map .end
                                        |> Maybe.withDefault { row = 1, col = 1 }
                            in
                            SourcePosition.at
                                start
                                endLocation
                                (AST.When { expression = expr, branches = branches })
                        )
            )
        |> Space.scopeIndentToLineStart


whenBranchParser : Parser Context Error AST.WhenBranch
whenBranchParser =
    Parser.succeed (\pattern body -> { pattern = pattern, body = body })
        |> Parser.keep (Parser.mapError PatternError Pattern.aliasTopLevelParser)
        |> Parser.skip spaceParser
        |> Parser.skip (Parser.keyword "->" (ExpectedKeyword "->"))
        |> Parser.skip spaceParser
        |> Parser.skip checkIndent
        |> Parser.keep (Space.scopeIndentToCurrentColumn (Parser.lazy (\_ -> parser)))
        |> Space.scopeIndentToLineStart


whenBranchLoopParser : Builder AST.WhenBranch -> Parser Context Error (Parser.Step (Builder AST.WhenBranch) (Array AST.WhenBranch))
whenBranchLoopParser branches =
    Parser.oneOf
        [ Parser.succeed (\branch -> Parser.Loop (Builder.pushLast branch branches))
            |> Parser.skip checkIndent
            |> Parser.keep whenBranchParser
        , Parser.succeed branches
            |> Parser.map (\b -> Parser.Done <| Builder.toArray b)
        ]


-- FUNCTION


function : Parser Context Error AST.Expression_
function =
    Parser.succeed identity
        |> Parser.skip (Parser.chompChar '\\' (ExpectedChar '\\'))
        |> Parser.skip spaceParser
        |> Parser.keep (Parser.mapError PatternError Pattern.parserNoAlias)
        |> Parser.skip spaceParser
        |> Parser.andThen
            (\firstArg ->
                Parser.succeed
                    (\args body ->
                        AST.Lambda
                            { patterns = args
                            , body = body
                            }
                    )
                    |> Parser.keep (Parser.loop (Builder.pushLast firstArg (Builder.empty 1)) (functionArgsParser "->"))
                    |> Parser.skip spaceParser
                    |> Parser.keep parser
                    |> Parser.skip spaceParser
            )


functionArgsParser : String -> Builder AST.Pattern -> Parser Context Error (Parser.Step (Builder AST.Pattern) (Array AST.Pattern))
functionArgsParser terminator array =
    Parser.oneOf
        [ Parser.succeed array
            |> Parser.skip (Parser.token terminator (ExpectedKeyword terminator))
            |> Parser.map (\a -> Parser.Done <| Builder.toArray a)
        , Parser.succeed (\expr -> Parser.Loop (Builder.pushLast expr array))
            |> Parser.keep (Parser.mapError PatternError Pattern.parserNoAlias)
            |> Parser.skip spaceParser
        ]


-- TERM

possiblyNegativeTerm : Parser Context Error AST.Expression
possiblyNegativeTerm =
    Parser.oneOf
        [ Parser.succeed (\start expr end -> SourcePosition.at start end (AST.Negate expr))
            |> Parser.keep Parser.getPosition
            |> Parser.skip (Parser.chompChar '-' (ExpectedChar '-'))
            |> Parser.keep term
            |> Parser.keep Parser.getPosition
        , term
        ]


term : Parser Context Error AST.Expression
term =
    Parser.succeed (\start expr end -> SourcePosition.at start end expr)
        |> Parser.keep Parser.getPosition
        |> Parser.keep
            ( Parser.oneOf
                [ Parser.succeed AST.Parens
                    |> Parser.skip (Parser.chompChar '(' (ExpectedChar '('))
                    |> Parser.skip spaceParser
                    |> Parser.keep
                        (Parser.oneOf
                            [ Parser.succeed
                                (\pos ->
                                    { start = pos
                                    , value = AST.Operator "-"
                                    , end = { pos | col = pos.col + 1 }
                                    }
                                )
                                |> Parser.keep Parser.getPosition
                                -- TODO: Hacky. Doesn't support ( - ) (last spaces)
                                |> Parser.skip (Parser.token "-)" (ExpectedChar '-'))
                            , Parser.succeed identity
                                |> Parser.keep (SourcePosition.parser operatorParser)
                                |> Parser.skip spaceParser
                                |> Parser.andThen
                                    (\operator ->
                                        Parser.succeed
                                            { start = operator.start
                                            , value = AST.Operator operator.value
                                            , end = operator.end
                                            }
                                    )
                                |> Parser.skip spaceParser
                                |> Parser.skip (Parser.chompChar ')' (ExpectedChar ')'))
                             , Parser.lazy (\_ -> parser)
                                |> Parser.skip spaceParser
                                |> Parser.skip (Parser.chompChar ')' (ExpectedChar ')'))
                            ]
                        )
                , function
                , lowerCaseVariable
                    |> Parser.map (\name -> AST.Var { name = name, varType = AST.LowVar })
                , Variable.foreignVar
                    |> Parser.mapError VariableError
                    |> Parser.andThen
                        (\foreign ->
                            when foreign is
                                Variable.Unqualified name ->
                                    Parser.succeed (AST.Var { name = name, varType = AST.CapVar })

                                Variable.Qualified { module_, name } ->
                                    when String.popFirst name is
                                        Just { first } ->
                                            Parser.succeed <|
                                                if Char.isUpper first then
                                                    AST.VarQual
                                                        { name = name
                                                        , qualifier = module_
                                                        , varType = AST.CapVar
                                                        }

                                                else
                                                    AST.VarQual
                                                        { name = name
                                                        , qualifier = module_
                                                        , varType = AST.LowVar
                                                        }

                                        Nothing ->
                                            Parser.problem InternalError
                        )
                , Number.parser
                    |> Parser.mapError NumberError
                    |> Parser.map AST.NumberLiteral
                , String.char
                    |> Parser.mapError StringError
                    |> Parser.map AST.CharLiteral
                , String.string
                    |> Parser.mapError StringError
                    |> Parser.map AST.StringLiteral
                , arrayParser
                    |> Parser.map AST.ArrayLiteral
                , recordParser
                , Parser.succeed AST.Accessor
                    |> Parser.skip (Parser.chompChar '.' (ExpectedChar '.'))
                    |> Parser.keep lowerCaseVariable
                , Parser.succeed identity
                    |> Parser.skip (Parser.chompChar '_' (ExpectedChar '_'))
                    |> Parser.keep lowerCaseVariable
                    |> Parser.andThen (\_ -> Parser.problem WildcardAttempt)
                ]
            )
        |> Parser.keep Parser.getPosition
        |> Parser.andThen
            (\expr ->
                when expr.value is
                    AST.Var { varType = AST.LowVar } ->
                        accessible expr

                    AST.VarQual { varType = AST.LowVar } ->
                        accessible expr

                    AST.Record _ ->
                        accessible expr

                    AST.Update _ ->
                        accessible expr

                    AST.Parens _ ->
                        accessible expr

                    AST.Lambda { body } ->
                        -- Use body.end for entire expression
                        Parser.succeed <|
                            SourcePosition.at
                                expr.start
                                body.end
                                expr.value
                                

                    _ ->
                        Parser.succeed expr
            )


lowerCaseVariable : Parser Context Error String
lowerCaseVariable =
    Variable.lowerCase
        |> Parser.mapError VariableError


accessible : AST.Expression -> Parser Context Error AST.Expression
accessible currentExpression =
    Parser.oneOf
        [ Parser.succeed
            (\name end ->
                SourcePosition.at
                    currentExpression.start
                    end
                    (AST.Access
                        { accessor = name
                        , expression = currentExpression
                        }
                    )
            )
            |> Parser.skip (Parser.chompChar '.' (ExpectedChar '.'))
            |> Parser.keep lowerCaseVariable
            |> Parser.keep Parser.getPosition
            |> Parser.andThen accessible
        , Parser.succeed currentExpression
        ]


-- ARRAY


arrayParser : Parser Context Error (Array AST.Expression)
arrayParser =
    Parser.succeed identity
        |> Parser.skip (Parser.chompChar '[' (ExpectedChar '['))
        |> Parser.skip spaceParser
        |> Parser.keep
            (Parser.oneOf
                [ Parser.succeed []
                    |> Parser.skip (Parser.chompChar ']' (ExpectedChar ']'))
                , Parser.lazy (\_ -> parser)
                    |> Parser.andThen
                        (\firstElement ->
                            Parser.succeed identity
                                |> Parser.skip spaceParser
                                |> Parser.keep (Parser.loop (Builder.pushLast firstElement (Builder.empty 1)) innerArrayParser)
                        )
                ]
            )


innerArrayParser : Builder AST.Expression -> Parser Context Error (Parser.Step (Builder AST.Expression) (Array AST.Expression))
innerArrayParser array =
    Parser.oneOf
        [ Parser.succeed array
            |> Parser.skip (Parser.chompChar ']' (ExpectedChar ']'))
            |> Parser.map (\a -> Parser.Done <| Builder.toArray a)
        , Parser.succeed (\expr -> Parser.Loop (Builder.pushLast expr array))
            |> Parser.skip (Parser.chompChar ',' (ExpectedChar ','))
            |> Parser.skip spaceParser
            |> Parser.keep (Parser.lazy (\_ -> parser))
            |> Parser.skip spaceParser
        ]


-- RECORD


recordParser : Parser Context Error AST.Expression_
recordParser =
    Parser.succeed identity
        |> Parser.skip (Parser.chompChar '{' (ExpectedChar '{'))
        |> Parser.skip spaceParser
        |> Parser.keep
            (Parser.oneOf
                [ Parser.succeed (AST.Record [])
                    |> Parser.skip (Parser.chompChar '}' (ExpectedChar '}'))
                , Parser.succeed identity
                    |> Parser.keep (Parser.lazy (\_ -> parser))
                    |> Parser.skip spaceParser
                    |> Parser.andThen
                        (\firstVarName ->
                            Parser.oneOf
                                [ Parser.succeed identity
                                    |> Parser.skip (Parser.chompChar '|' (ExpectedChar '|'))
                                    |> Parser.skip spaceParser
                                    |> Parser.keep recordFieldParser
                                    |> Parser.andThen
                                        (\firstPair ->
                                            Parser.succeed
                                                (\fields ->
                                                    AST.Update
                                                        { record = firstVarName
                                                        , newValues = fields
                                                        }
                                                )
                                                |> Parser.skip spaceParser
                                                |> Parser.keep (Parser.loop (Builder.pushLast firstPair (Builder.empty 1)) innerRecordParser)
                                        )
                                , Parser.succeed identity
                                    |> Parser.skip (Parser.chompChar '=' (ExpectedChar '='))
                                    |> Parser.skip spaceParser
                                    |> Parser.keep (Parser.lazy (\_ -> parser))
                                    |> Parser.skip spaceParser
                                    |> Parser.andThen
                                        (\value ->
                                            when firstVarName.value is
                                                AST.Var { name, varType = AST.LowVar } ->
                                                    let
                                                        locatedField =
                                                            SourcePosition.at firstVarName.start firstVarName.end name
                                                    in
                                                    Parser.succeed AST.Record
                                                        |> Parser.skip spaceParser
                                                        |> Parser.keep
                                                            (Parser.loop
                                                                (Builder.pushLast { field = locatedField, value = value } (Builder.empty 1))
                                                                innerRecordParser
                                                            )

                                                _ ->
                                                    Parser.problem (ExpectedLowerVariable firstVarName)
                                        )
                                ]
                        )
                ]
            )


recordFieldParser : Parser Context Error AST.RecordField
recordFieldParser =
    Parser.succeed
        (\fieldStart field fieldEnd value ->
            { field = SourcePosition.at fieldStart fieldEnd field
            , value = value
            }
        )
        |> Parser.keep Parser.getPosition
        |> Parser.keep lowerCaseVariable
        |> Parser.keep Parser.getPosition
        |> Parser.skip spaceParser
        |> Parser.skip (Parser.chompChar '=' (ExpectedChar '='))
        |> Parser.skip spaceParser
        |> Parser.keep (Parser.lazy (\_ -> parser))


innerRecordParser : Builder AST.RecordField -> Parser Context Error (Parser.Step (Builder AST.RecordField) (Array AST.RecordField))
innerRecordParser array =
    Parser.oneOf
        [ Parser.succeed array
            |> Parser.skip (Parser.chompChar '}' (ExpectedChar '}'))
            |> Parser.map (\a -> Parser.Done <| Builder.toArray a)
        , Parser.succeed (\expr -> Parser.Loop (Builder.pushLast expr array))
            |> Parser.skip (Parser.chompChar ',' (ExpectedChar ','))
            |> Parser.skip spaceParser
            |> Parser.keep recordFieldParser
            |> Parser.skip spaceParser
        ]


spaceParser : Parser Context Error {}
spaceParser =
    Parser.mapError SpaceError Space.parser


checkIndent : Parser Context Error {}
checkIndent =
    Parser.mapError (\_ -> IndentError) Space.checkIndent


checkIndentAtLeastEqual : Parser Context Error {}
checkIndentAtLeastEqual =
    Parser.mapError (\_ -> IndentError) Space.checkIndentAtLeastEqual
