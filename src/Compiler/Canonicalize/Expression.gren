module Compiler.Canonicalize.Expression exposing
    ( Context
    , Error (..)
    , ScopeEntry (..)
    , OneOrMoreQualifiedEntries
    , QualifiedEntry
    , canonicalize
    , canonicalizePattern
    , canonicalizeLetDef
    )


import Compiler.Ast.Source as ParseAst
import Compiler.Ast.Canonical as CanonicalAst exposing (Annotation)
import Compiler.Parse.Number as Number
import Compiler.SourcePosition as SourcePosition
import Compiler.ModuleName as ModuleName exposing (ModuleName)
import Compiler.PackageName as PackageName exposing (PackageName)
import Dict exposing (Dict)
import Set exposing (Set)


type Error
    = PlaceholderError
    | InvalidModuleName String
    | ModuleNotFound String
    | UnknownVar String
    | AmbiguousVar { name : String, modules : Array { package : PackageName, module_ : ModuleName } }
    | NotExposed { mod : String, name : String }
    | DuplicateBinding { name : String, existingPosition : SourcePosition.Region }


{-| Entry in the scope dictionary, representing how an unqualified name resolves.
-}
type ScopeEntry
    = Local { position : SourcePosition.Region }
    | Imported { entry : QualifiedEntry, position : SourcePosition.Region }


{-| Context for canonicalization:
-}
type alias Context =
    { pkg : PackageName
    , currentModule : ModuleName
    -- Dict <qualifier> (Dict <name> entry)
    , qualifiedVars : Dict String (Dict String OneOrMoreQualifiedEntries)
    , scope : Dict String ScopeEntry
    }


type alias OneOrMoreQualifiedEntries =
    { first : QualifiedEntry
    , rest : Array QualifiedEntry
    }


{-| Information about a qualified variable entry.
-}
type alias QualifiedEntry =
     { module_ : ModuleName
     , package : PackageName
     , annotation : Annotation
     }


{-| Canonicalize a single expression.
-}
canonicalize : Context -> ParseAst.Expression -> Result Error CanonicalAst.Expression
canonicalize context expr =
    canonicalize_ context expr.value
        |> Result.map (SourcePosition.at expr.start expr.end)


canonicalize_ : Context -> ParseAst.Expression_ -> Result Error CanonicalAst.Expression_
canonicalize_ context expr =
    when expr is
        ParseAst.NumberLiteral numberOutcome ->
            when numberOutcome is
                Number.Integer intVal ->
                    Ok (CanonicalAst.Int intVal)

                Number.FloatingPoint { val } ->
                    Ok (CanonicalAst.Float val)

                Number.Hex hexVal ->
                    Ok (CanonicalAst.Int hexVal)

        ParseAst.CharLiteral char ->
            Ok (CanonicalAst.Chr char)

        ParseAst.StringLiteral str ->
            Ok (CanonicalAst.Str str)

        ParseAst.Accessor str ->
            Ok (CanonicalAst.Accessor str)

        ParseAst.Parens innerExpr ->
            canonicalize_ context innerExpr.value

        ParseAst.VarQual { qualifier, name } ->
            if String.startsWith "Gren.Kernel." qualifier then
                -- TODO: verify existance of module?
                Ok (CanonicalAst.VarKernel { kernelModule = qualifier, name = name })

            else
                when Dict.get qualifier context.qualifiedVars is
                    Just innerDict ->
                        when Dict.get name innerDict is
                            Just { first = entry, rest = [] } ->
                                    if entry.package == PackageName.core && ModuleName.toString entry.module_ == "Debug" then
                                        Ok (CanonicalAst.VarDebug { home = entry.module_, name = name, annotation = entry.annotation })

                                    else if entry.package == context.pkg then
                                        Ok (CanonicalAst.VarTopLevel { home = entry.module_, name = name })

                                    else
                                        Ok (CanonicalAst.VarForeign { home = entry.module_, name = name, annotation = entry.annotation })

                            Just { first, rest } ->
                                let
                                    mods =
                                        Array.pushFirst first rest
                                            |> Array.map (\e -> { package = e.package, module_ = e.module_ })
                                in
                                Err (AmbiguousVar { name = name, modules = mods })

                            Nothing ->
                                Err (NotExposed { mod = qualifier, name = name })

                    Nothing ->
                        Err (ModuleNotFound qualifier)

        ParseAst.Var { name } ->
            -- Handle unqualified names from scope (locals, imports, top-level)
            when Dict.get name context.scope is
                Just (Local localEntry) ->
                    Ok (CanonicalAst.VarLocal name)

                Just (Imported importedEntry) ->
                    let
                        entry =
                            importedEntry.entry
                        moduleStr =
                            ModuleName.toString entry.module_
                    in
                    if String.startsWith "Gren.Kernel." moduleStr then
                        Ok (CanonicalAst.VarKernel { kernelModule = moduleStr, name = name })

                    else if entry.package == PackageName.core && moduleStr == "Debug" then
                        Ok (CanonicalAst.VarDebug { home = entry.module_, name = name, annotation = entry.annotation })

                    else if entry.package == context.pkg then
                        Ok (CanonicalAst.VarTopLevel { home = entry.module_, name = name })

                    else
                        Ok (CanonicalAst.VarForeign { home = entry.module_, name = name, annotation = entry.annotation })

                Nothing ->
                    Err (UnknownVar name)

        ParseAst.Call { fn, args } ->
            let
                canonArgsResult =
                    Array.foldr
                        (\arg acc ->
                            Result.map2
                                (\canonArg canonArgs -> Array.pushFirst canonArg canonArgs)
                                (canonicalize context arg)
                                acc
                        )
                        (Ok [])
                        args
            in
            Result.map2
                (\canonFn canonArgs ->
                    CanonicalAst.Call
                        { fn = canonFn
                        , args = canonArgs
                        }
                )
                (canonicalize context fn)
                canonArgsResult

        ParseAst.Let { defs, body } ->
            -- TODO: simplify
            -- TODO: Add parameter scoping for function definitions
            -- TODO: Add top-level function name in scope for recursive calls
            -- TODO: Add destructuring pattern support for let-bindings
            let
                -- Build extended scope with duplicate checking
                extendedScopeResult =
                    Array.foldl
                        (\def accResult ->
                            let
                                nameDef =
                                    getLetDefName def

                                name =
                                    nameDef.value
                            in
                            Result.andThen
                                (\scope ->
                                    when Dict.get name scope is
                                        Just existingEntry ->
                                            let
                                                existingPosition =
                                                    when existingEntry is
                                                        Local local ->
                                                            local.position

                                                        Imported imported ->
                                                            imported.position
                                            in
                                            Err
                                                (DuplicateBinding
                                                    { name = name
                                                    , existingPosition = existingPosition
                                                    }
                                                )

                                        Nothing ->
                                            let
                                                entry =
                                                    Local
                                                        { position = { start = nameDef.start, end = nameDef.end } }
                                            in
                                            Ok (Dict.set name entry scope)
                                )
                                accResult
                        )
                        (Ok context.scope)
                        defs
            in
            Result.andThen
                (\extendedScope ->
                    let
                        extendedContext =
                            { context | scope = extendedScope }

                        -- Canonicalize all definitions with the extended scope
                        canonicalDefsResult =
                            Array.foldl
                                (\def acc ->
                                    Result.andThen
                                        (\currentDefs ->
                                            Result.map
                                                (\d -> Array.pushLast d currentDefs)
                                                (canonicalizeLetDef extendedContext def)
                                        )
                                        acc
                                )
                                (Ok [])
                                defs
                    in
                    Result.andThen
                        (\canonicalDefs ->
                            -- Canonicalize body with extended scope
                            Result.andThen
                                (\canonicalBody ->
                                    if Array.length canonicalDefs == 1 then
                                        when Array.get 0 canonicalDefs is
                                            Just singleDef ->
                                                Ok (CanonicalAst.Let
                                                    { def = singleDef
                                                    , body = canonicalBody
                                                    }
                                                )
                                            Nothing ->
                                                Err PlaceholderError
                                    else
                                        Ok (CanonicalAst.LetRec
                                            { defs = canonicalDefs
                                            , body = canonicalBody
                                            }
                                        )
                                )
                                (canonicalize extendedContext body)
                        )
                        canonicalDefsResult
                )
                extendedScopeResult

        _ ->
            Err PlaceholderError


-- Helpers


canonicalizePattern : ParseAst.Pattern -> Result Error CanonicalAst.Pattern
canonicalizePattern pat =
    when pat.value is
        ParseAst.PVar name ->
            Ok (SourcePosition.at pat.start pat.end (CanonicalAst.PVar name))

        _ ->
            Err PlaceholderError


getLetDefName : SourcePosition.Located ParseAst.Def -> SourcePosition.Located String
getLetDefName def =
    when def.value is
        ParseAst.Define record ->
            record.name

        ParseAst.Destruct { pattern, body } ->
            when pattern.value is
                ParseAst.PVar name -> SourcePosition.at pattern.start pattern.end name
                _ -> Debug.todo "Non-PVar destruct patterns not yet supported in Let"


canonicalizeLetDef : Context -> SourcePosition.Located ParseAst.Def -> Result Error CanonicalAst.Def
canonicalizeLetDef context def =
    -- TODO: simplify
    when def.value is
        ParseAst.Define record ->
            let
                paramsResult =
                    Array.foldl
                        (\pat acc ->
                            Result.andThen
                                (\currentParams ->
                                    Result.map
                                        (\p -> Array.append currentParams [p])
                                        (canonicalizePattern pat)
                                )
                                acc
                        )
                        (Ok [])
                        record.args
            in
            Result.map2
                (\params body ->
                    CanonicalAst.Def
                        { name = record.name
                        , params = params
                        , body = body
                        }
                )
                paramsResult
                (canonicalize context record.body)

        ParseAst.Destruct { pattern, body } ->
            Result.map2
                (\canonPattern canonBody ->
                    when pattern.value is
                        ParseAst.PVar name ->
                            Ok (CanonicalAst.Def
                                { name = SourcePosition.at pattern.start pattern.end name
                                , params = []
                                , body = canonBody
                                }
                            )
                        _ ->
                            -- For non-PVar patterns, we'll need more complete pattern support
                            Err PlaceholderError
                )
                (canonicalizePattern pattern)
                (canonicalize context body)
                |> Result.andThen Basics.identity
