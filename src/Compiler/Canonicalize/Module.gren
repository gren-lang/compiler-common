module Compiler.Canonicalize.Module exposing
    ( SourceModule
    , Error (..)
    , canonicalize
    )

import Compiler.Ast.Source as ParseAst
import Compiler.Ast.Canonical as CanonicalAst
import Compiler.Canonicalize.Expression as Expression
import Compiler.PackageName as PackageName exposing (PackageName)
import Compiler.ModuleName as ModuleName exposing (ModuleName)
import Compiler.SourcePosition as SourcePosition
import Compiler.Parse.Number as Number
import Dict exposing (Dict)
import Array
import Set exposing (Set)


type alias SourceModule =
    { package : PackageName
    , ast : ParseAst.Module
    }


type Error
    = PlaceholderError
    | InvalidModuleName String
    | ExpressionError Expression.Error
    | CyclicDependency String
    | ModuleNotFound String


isInStack : String -> Array String -> Bool
isInStack name stack =
    Array.any ((==) name) stack


{-| Extract all module dependencies from requires and imports.
-}
getModuleDependencies : ParseAst.Module -> Array String
getModuleDependencies mod =
    when mod is
        ParseAst.Implementation impl ->
            let
                reqNames : Array String
                reqNames =
                    impl.requires
                        |> Array.map (\reqLoc -> reqLoc.value.module_.value)

                impNames : Array String
                impNames =
                    impl.imports
                        |> Array.map (\impLoc -> impLoc.value.module_.value)
            in
            Array.append reqNames impNames

        ParseAst.Signature _ ->
            []


{-| Canonicalize exports from a module.
-}
canonicalizeExports : ParseAst.Exposing -> SourcePosition.Region -> Result Error CanonicalAst.Exports
canonicalizeExports exposings region =
    when exposings is
        ParseAst.Open ->
            Ok (CanonicalAst.ExportEverything region)

        ParseAst.Explicit _ ->
            Err PlaceholderError


{-| Canonicalize a single definition (value).
For now, only handles simple definitions without type signatures.
-}
canonicalizeDef : Expression.Context -> ParseAst.Value -> Result Error CanonicalAst.Def
canonicalizeDef context value =
    when value.signature is
        Nothing ->
            Result.map2
                (\params body ->
                    CanonicalAst.Def
                        { name = value.name
                        , params = params
                        , body = body
                        }
                )
                (Array.foldl
                    (\pat acc ->
                        Result.andThen
                            (\current ->
                                Result.map
                                    (\p -> Array.append current [p])
                                    (Expression.canonicalizePattern pat)
                            )
                            acc
                    )
                    (Ok [])
                    value.args
                    |> Result.mapError ExpressionError
                )
                (Expression.canonicalize context value.body |> Result.mapError ExpressionError)

        Just _ ->
            Err PlaceholderError


{-| Canonicalize effects.
-}
canonicalizeEffects : ParseAst.Effects -> Result Error CanonicalAst.Effects
canonicalizeEffects effects =
    when effects is
        ParseAst.NoEffects ->
            Ok CanonicalAst.NoEffects

        _ ->
            Err PlaceholderError


{-| Canonicalize dependencies of a module.
Processes all requires and imports in order, canonicalizing each dependency.
-}
canonicalizeDependencies :
    PackageName ->
    Dict String SourceModule ->
    Dict String CanonicalAst.Module ->
    Array String ->
    ParseAst.Module ->
    Result Error (Dict String CanonicalAst.Module)
canonicalizeDependencies pkg parsedModules modules recursionStack ast =
    let
        depNames : Array String
        depNames =
            getModuleDependencies ast
    in
    Array.foldl
        (\depName accResult ->
            Result.andThen
                (\currentModules ->
                    if Dict.member depName currentModules then
                        Ok currentModules

                    else if isInStack depName recursionStack then
                        Err (CyclicDependency depName)

                    else
                        when Dict.get depName parsedModules is
                            Just parsedDep ->
                                canonicalizeModule pkg parsedModules currentModules (Array.append recursionStack [depName]) parsedDep

                            Nothing ->
                                Err (ModuleNotFound depName)
                )
                accResult
        )
        (Ok modules)
        depNames


{-| Canonicalize a full module, ensuring dependencies are canonicalized first.
-}
canonicalizeModule :
    PackageName ->
    Dict String SourceModule ->
    Dict String CanonicalAst.Module ->
    Array String ->
    SourceModule ->
    Result Error (Dict String CanonicalAst.Module)
canonicalizeModule pkg parsedModules modules recursionStack sourceModule =
    let
        modName : String
        modName =
            (ParseAst.moduleName sourceModule.ast).value
    in
    if isInStack modName recursionStack then
        Err (CyclicDependency modName)

    else if Dict.member modName modules then
        Ok modules

    else
        let
            newStack : Array String
            newStack =
                Array.append recursionStack [modName]
        in
        Result.andThen
            (\modulesWithDeps ->
                let
                    currentMod : ModuleName
                    currentMod =
                        when ModuleName.fromString modName is
                            Just mn -> mn
                            Nothing -> Debug.todo "Invalid module name"
                in
                canonicalizeModuleContent pkg sourceModule
                    { pkg = pkg
                    , currentModule = currentMod
                    , modules = modulesWithDeps
                    , scope = Set.empty
                    }
                    |> Result.map (\canonModule -> Dict.set modName canonModule modulesWithDeps)
            )
            (canonicalizeDependencies pkg parsedModules modules newStack sourceModule.ast)


{-| Canonicalize module content (Implementation only).
For now, only handles Implementation modules with a single value definition.
-}
canonicalizeModuleContent :
    PackageName ->
    SourceModule ->
    Expression.Context ->
    Result Error CanonicalAst.Module
canonicalizeModuleContent pkg parsedModule context =
    when parsedModule.ast is
        ParseAst.Implementation impl ->
            when ModuleName.fromString impl.name.value is
                Just moduleName ->
                    let
                        exportsResult : Result Error CanonicalAst.Exports
                        exportsResult =
                            canonicalizeExports impl.exports { start = impl.name.start, end = impl.name.end }

                        effectsResult : Result Error CanonicalAst.Effects
                        effectsResult =
                            canonicalizeEffects impl.effects
                    in
                    Result.map2
                        (\canonicalExports canonicalEffects ->
                            -- Handle only the case with a single value, no unions, aliases, binops
                            if Array.length impl.values == 1
                                && Array.isEmpty impl.unions
                                && Array.isEmpty impl.aliases
                                && Array.isEmpty impl.binops then
                                when Array.get 0 impl.values is
                                    Just singleValueDecl ->
                                        canonicalizeDef context singleValueDecl.value.value
                                            |> Result.map
                                                (\canonDef ->
                                                    { name = moduleName
                                                    , exports = canonicalExports
                                                    , decls = CanonicalAst.Declare { def = canonDef, decls = CanonicalAst.SaveTheEnvironment }
                                                    , unions = Dict.empty
                                                    , aliases = Dict.empty
                                                    , binops = Dict.empty
                                                    , effects = canonicalEffects
                                                    }
                                                )

                                    Nothing ->
                                        Err PlaceholderError

                            else
                                Err PlaceholderError
                        )
                        exportsResult
                        effectsResult
                        |> Result.andThen Basics.identity

                Nothing ->
                    Err (InvalidModuleName impl.name.value)

        ParseAst.Signature _ ->
            Err PlaceholderError


{-| Takes in a `Dict` of parsed modules, where the `String` key represents a module name, and returns
a `Dict` of canonicalized modules, or `Error`
-}
canonicalize : PackageName -> Dict String SourceModule -> Dict String CanonicalAst.Module -> Result Error (Dict String CanonicalAst.Module)
canonicalize pkg parsedModules initialModules =
    Dict.foldl
        (\key parsedModule resultAcc ->
            Result.andThen
                (\modulesSoFar ->
                    if Dict.member key modulesSoFar then
                        Ok modulesSoFar

                    else
                        canonicalizeModule pkg parsedModules modulesSoFar [] parsedModule
                )
                resultAcc
        )
        (Ok initialModules)
        parsedModules
