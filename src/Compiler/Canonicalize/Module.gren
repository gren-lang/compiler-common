module Compiler.Canonicalize.Module exposing
    ( SourceModule
    , Error (..)
    , canonicalize
    )

import Compiler.Ast.Source as ParseAst
import Compiler.Ast.Canonical as CanonicalAst
import Compiler.Canonicalize.Expression as Expression
import Compiler.PackageName as PackageName exposing (PackageName)
import Compiler.ModuleName as ModuleName exposing (ModuleName)
import Compiler.SourcePosition as SourcePosition
import Compiler.Parse.Number as Number
import Dict exposing (Dict)
import Array
import Set exposing (Set)


type alias SourceModule =
    { package : PackageName
    , ast : ParseAst.Module
    }


type Error
    = PlaceholderError
    | ExpressionError Expression.Error
    | CyclicDependency ModuleName
    | ModuleNotFound ModuleName


{-| Takes in a `Dict` of parsed modules, where the `String` key represents a module name, and returns
a `Dict` of canonicalized modules, or `Error`
-}
canonicalize : PackageName -> Dict String SourceModule -> Dict String CanonicalAst.Module -> Result Error (Dict String CanonicalAst.Module)
canonicalize pkg parsedModules initialModules =
    Dict.foldl
        (\key parsedModule resultAcc ->
            Result.andThen
                (\modulesSoFar ->
                    if Dict.member key modulesSoFar then
                        Ok modulesSoFar

                    else
                        canonicalizeModule pkg parsedModules modulesSoFar Set.empty parsedModule
                )
                resultAcc
        )
        (Ok initialModules)
        parsedModules


{-| Canonicalize a full module, ensuring dependencies are canonicalized first.
-}
canonicalizeModule :
    PackageName ->
    Dict String SourceModule ->
    Dict String CanonicalAst.Module ->
    Set String ->
    SourceModule ->
    Result Error (Dict String CanonicalAst.Module)
canonicalizeModule pkg parsedModules modules recursionStack sourceModule =
    let
        modName =
            (ParseAst.moduleName sourceModule.ast).value

        modNameString =
            ModuleName.toString modName
    in
    if Set.member modNameString recursionStack then
        Err (CyclicDependency modName)

    else if Dict.member modNameString modules then
        Ok modules

    else
        let
            newStack =
                Set.set modNameString recursionStack
        in
        Result.andThen
            (\modulesWithDeps ->
                canonicalizeModuleContent pkg sourceModule
                    { pkg = pkg
                    , currentModule = modName
                    , qualifiedVars = Dict.empty
                    , qualifiedCtors = Dict.empty
                    , scope = Dict.empty
                    , scopedCtors = Dict.empty
                    , scopedOperators = Dict.empty
                    }
                    |> Result.map (\canonModule -> Dict.set modNameString canonModule modulesWithDeps)
            )
            (canonicalizeDependencies pkg parsedModules modules newStack sourceModule.ast)


{-| Canonicalize module content (Implementation only).
For now, only handles Implementation modules with a single value definition.
-}
canonicalizeModuleContent : PackageName -> SourceModule -> Expression.Context -> Result Error CanonicalAst.Module
canonicalizeModuleContent pkg parsedModule rootContext =
    when parsedModule.ast is
        ParseAst.Implementation impl ->
            let
                context =
                    { rootContext | scope =
                        Array.foldl
                            (\val dict ->
                                Dict.set
                                    val.value.value.name.value
                                    (Expression.Local { position = { start = val.start, end = val.end } })
                                    dict
                            )
                            rootContext.scope
                            impl.values
                    }

                exportsResult =
                    canonicalizeExports impl.exports { start = impl.name.start, end = impl.name.end }

                effectsResult =
                    canonicalizeEffects impl.effects

                decsResult =
                    Array.foldl
                        (\decl declsResult ->
                            Result.andThen
                                (\decls ->
                                    canonicalizeDef context decl.value.value
                                        |> Result.map (\d -> CanonicalAst.Declare { def = d, decls = decls })
                                )
                                declsResult
                        )
                        (Ok CanonicalAst.SaveTheEnvironment)
                        impl.values
            in
            Result.map3
                (\canonicalExports canonicalEffects canDecls ->
                    { name = impl.name.value
                    , exports = canonicalExports
                    , decls = canDecls
                    , unions = Dict.empty
                    , aliases = Dict.empty
                    , binops = Dict.empty
                    , effects = canonicalEffects
                    }
                )
                exportsResult
                effectsResult
                decsResult

        ParseAst.Signature _ ->
            Err PlaceholderError


{-| Extract all module dependencies from requires and imports.
-}
getModuleDependencies : ParseAst.Module -> Array ModuleName
getModuleDependencies mod =
    when mod is
        ParseAst.Implementation impl ->
            let
                reqNames =
                    Array.map (\reqLoc -> reqLoc.value.module_.value) impl.requires

                impNames =
                    Array.map (\impLoc -> impLoc.value.module_.value) impl.imports
            in
            Array.append reqNames impNames

        ParseAst.Signature _ ->
            []


{-| Canonicalize exports from a module.
-}
canonicalizeExports : ParseAst.Exposing -> SourcePosition.Region -> Result Error CanonicalAst.Exports
canonicalizeExports exposings region =
    when exposings is
        ParseAst.Open ->
            Ok (CanonicalAst.ExportEverything region)

        ParseAst.Explicit _ ->
            Err PlaceholderError


{-| Canonicalize a single definition (value).
For now, only handles simple definitions without type signatures.
-}
canonicalizeDef : Expression.Context -> ParseAst.Value -> Result Error CanonicalAst.Def
canonicalizeDef context value =
    when value.signature is
        Nothing ->
            Result.map2
                (\params body ->
                    CanonicalAst.Def
                        { name = value.name
                        , params = params
                        , body = body
                        }
                )
                (Array.foldl
                    (\pat acc ->
                        Result.andThen
                            (\current ->
                                Result.map
                                    (\p -> Array.append current [p])
                                    (Expression.canonicalizePattern context pat)
                            )
                            acc
                    )
                    (Ok [])
                    value.args
                    |> Result.mapError ExpressionError
                )
                (Expression.canonicalize context value.body |> Result.mapError ExpressionError)

        Just _ ->
            Err PlaceholderError


{-| Canonicalize effects.
-}
canonicalizeEffects : ParseAst.Effects -> Result Error CanonicalAst.Effects
canonicalizeEffects effects =
    when effects is
        ParseAst.NoEffects ->
            Ok CanonicalAst.NoEffects

        _ ->
            Err PlaceholderError


{-| Canonicalize dependencies of a module.
Processes all requires and imports in order, canonicalizing each dependency.
-}
canonicalizeDependencies :
    PackageName ->
    Dict String SourceModule ->
    Dict String CanonicalAst.Module ->
    Set String ->
    ParseAst.Module ->
    Result Error (Dict String CanonicalAst.Module)
canonicalizeDependencies pkg parsedModules modules recursionStack ast =
    let
        depNames =
            getModuleDependencies ast
    in
    Array.foldl
        (\depName accResult ->
            Result.andThen
                (\currentModules ->
                    let
                        depNameStr =
                            ModuleName.toString depName
                    in
                    if Dict.member depNameStr currentModules then
                        Ok currentModules

                    else if Set.member depNameStr recursionStack then
                        Err (CyclicDependency depName)

                    else
                        when Dict.get depNameStr parsedModules is
                            Just parsedDep ->
                                canonicalizeModule
                                    pkg
                                    parsedModules
                                    currentModules
                                    (Set.set depNameStr recursionStack)
                                    parsedDep

                            Nothing ->
                                Err (ModuleNotFound depName)
                )
                accResult
        )
        (Ok modules)
        depNames
