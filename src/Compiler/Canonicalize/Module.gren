module Compiler.Canonicalize.Module exposing
    ( SourceModule
    , Error (..)
    , canonicalize
    )

import Compiler.Ast.Source as ParseAst
import Compiler.Ast.Canonical as CanonicalAst
import Compiler.Canonicalize.Expression as Expression
import Compiler.PackageName as PackageName exposing (PackageName)
import Compiler.ModuleName as ModuleName exposing (ModuleName)
import Compiler.SourcePosition as SourcePosition
import Compiler.Parse.Number as Number
import Dict exposing (Dict)
import Array
import Set exposing (Set)


type alias SourceModule =
    { package : PackageName
    , ast : ParseAst.Module
    }


type Error
    = PlaceholderError
    | ExpressionError Expression.Error
    | CyclicDependency ModuleName
    | ModuleNotFound ModuleName


{-| Takes in a `Dict` of parsed modules, where the `String` key represents a module name, and returns
a `Dict` of canonicalized modules, or `Error`
-}
canonicalize : PackageName -> Dict String SourceModule -> Dict String CanonicalAst.Module -> Result Error (Dict String CanonicalAst.Module)
canonicalize pkg parsedModules initialModules =
    Dict.foldl
        (\key parsedModule resultAcc ->
            Result.andThen
                (\modulesSoFar ->
                    if Dict.member key modulesSoFar then
                        Ok modulesSoFar

                    else
                        canonicalizeModule pkg parsedModules modulesSoFar Set.empty parsedModule
                )
                resultAcc
        )
        (Ok initialModules)
        parsedModules


{-| Canonicalize a full module, ensuring dependencies are canonicalized first.
-}
canonicalizeModule :
    PackageName ->
    Dict String SourceModule ->
    Dict String CanonicalAst.Module ->
    Set String ->
    SourceModule ->
    Result Error (Dict String CanonicalAst.Module)
canonicalizeModule pkg parsedModules modules recursionStack sourceModule =
    let
        modName =
            (ParseAst.moduleName sourceModule.ast).value

        modNameString =
            ModuleName.toString modName
    in
    if Set.member modNameString recursionStack then
        Err (CyclicDependency modName)

    else if Dict.member modNameString modules then
        Ok modules

    else
        let
            newStack =
                Set.set modNameString recursionStack
        in
        Result.andThen
            (\modulesWithDeps ->
                canonicalizeModuleContent pkg modulesWithDeps sourceModule
                    |> Result.map (\canonModule -> Dict.set modNameString canonModule modulesWithDeps)
            )
            (canonicalizeDependencies pkg parsedModules modules newStack sourceModule.ast)


{-| Canonicalize module content (Implementation only).
-}
canonicalizeModuleContent : PackageName -> Dict String CanonicalAst.Module -> SourceModule -> Result Error CanonicalAst.Module
canonicalizeModuleContent pkg canModules parsedModule =
    when parsedModule.ast is
        ParseAst.Implementation impl ->
            let
                canBinops =
                    Array.foldl
                        (\bin acc ->
                            let
                                binOp =
                                    bin.value
                            in
                            Dict.set
                                binOp.symbol
                                { name = binOp.fn
                                , associativity = binOp.associativity
                                , precedence = binOp.precedence
                                }
                                acc
                        )
                        Dict.empty
                        impl.binops

                context =
                    createExpressionContext pkg canModules impl

                exportsResult =
                    canonicalizeExports impl.exports { start = impl.name.start, end = impl.name.end }

                effectsResult =
                    canonicalizeEffects impl.effects

                typeAliasResult =
                    Array.foldl
                        (\alias acc ->
                            Result.andThen
                                (\canAliases ->
                                    Result.map
                                        (\canTipe ->
                                            Dict.set
                                                alias.value.value.name.value
                                                { vars = Array.map .value alias.value.value.vars
                                                , tipe = canTipe
                                                }
                                                canAliases
                                        )
                                        (canonicalizeType alias.value.value.type_)
                                )
                                acc
                        )
                        (Ok Dict.empty)
                        impl.aliases

                unionResult =
                    Array.foldl
                        (\union acc ->
                            Result.andThen
                                (\unions ->
                                    canonicalizeUnion context union.value.value
                                        |> Result.map
                                            (\u ->
                                                Dict.set
                                                    union.value.value.name.value
                                                    u
                                                    unions
                                            )
                                )
                                acc
                        )
                        (Ok Dict.empty)
                        impl.unions

                contextWithUnions =
                    unionResult
                        |> Result.map
                            (\us ->
                                Dict.values us
                                    |> Array.foldl
                                        (\union acc ->
                                            Array.foldl
                                                (\variant acc2 ->
                                                    Dict.set
                                                        variant.name
                                                        { first =
                                                             { module_ = impl.name.value
                                                             , package = impl.package
                                                             , union = union
                                                             , name = variant.name
                                                             , index = variant.index
                                                             , argType = variant.arg
                                                             }
                                                        -- TODO: what about collisions?
                                                        , rest = []
                                                        }
                                                        acc2
                                                )
                                                acc
                                                union.alts
                                        )
                                        Dict.empty
                            )
                        |> Result.map
                            (\ctors ->
                                { context | scopedCtors = ctors }
                            )
                        -- TODO: swallows error
                        |> Result.withDefault context

                decsResult =
                    Array.foldl
                        (\decl declsResult ->
                            Result.andThen
                                (\decls ->
                                    canonicalizeDef contextWithUnions decl.value.value
                                        |> Result.map (\d -> CanonicalAst.Declare { def = d, decls = decls })
                                )
                                declsResult
                        )
                        (Ok CanonicalAst.SaveTheEnvironment)
                        impl.values

            in
            Ok
                (\canonicalExports canonicalEffects canAlias canUnions canDecls ->
                    { name = impl.name.value
                    , package = impl.package
                    , exports = canonicalExports
                    , decls = canDecls
                    , unions = canUnions
                    , aliases = canAlias
                    , binops = canBinops
                    , effects = canonicalEffects
                    }
                )
                |> Result.andMap exportsResult
                |> Result.andMap effectsResult
                |> Result.andMap typeAliasResult
                |> Result.andMap unionResult
                |> Result.andMap decsResult

        ParseAst.Signature _ ->
            Err PlaceholderError


createExpressionContext : PackageName -> Dict String CanonicalAst.Module -> ParseAst.ModuleImplementation -> Expression.Context
createExpressionContext pkg canModules parsedModule =
    let
        topLevelScope =
            Array.foldl
                (\val dict ->
                    Dict.set
                        val.value.value.name.value
                        (Expression.Local { position = { start = val.start, end = val.end } })
                        dict
                )
                Dict.empty
                parsedModule.values
    in
    { pkg = pkg
    , currentModule = parsedModule.name.value
    , qualifiedVars = extractQualifiedVars canModules parsedModule
    , qualifiedCtors = Dict.empty
    , scope =
        Array.foldl
            (extractExposedVals canModules)
            topLevelScope
            (Array.map .value parsedModule.imports) -- TODO: de-duplicate
    , scopedCtors = Dict.empty
    , scopedOperators =
        parsedModule.binops
            |> Array.map .value
            |> Array.foldl
                (\infix acc ->
                    Dict.set infix.symbol { moduleName = parsedModule.name.value, operator = infix } acc
                )
                Dict.empty
    }


extractQualifiedVars : Dict String CanonicalAst.Module -> ParseAst.ModuleImplementation -> Dict String (Dict String (Expression.OneOrMore Expression.QualifiedEntry))
extractQualifiedVars canModules parsedModule =
    Array.foldl
        (extractQualifiedVarsHelper canModules)
        Dict.empty
        (Array.map .value parsedModule.imports)


extractQualifiedVarsHelper : Dict String CanonicalAst.Module -> ParseAst.Import -> Dict String (Dict String (Expression.OneOrMore Expression.QualifiedEntry)) -> Dict String (Dict String (Expression.OneOrMore Expression.QualifiedEntry))
extractQualifiedVarsHelper canModules mod qv =
    let
        modName =
            mod.module_.value

        qualifier =
            mod.alias
                |> Maybe.withDefault modName

        values =
            Dict.get (ModuleName.toString modName) canModules
                |> Maybe.map
                    (\m ->
                        let
                            normalizedDefs =
                                CanonicalAst.flattenDecls m.decls
                                    |> Array.map
                                        (\d ->
                                            when d is
                                                CanonicalAst.Def { name } ->
                                                    { name = name.value
                                                    , module_ = modName
                                                    , package = m.package
                                                    , annotation = dummyAnnotation -- TODO
                                                    }

                                                CanonicalAst.TypedDef { name } ->
                                                    { name = name.value
                                                    , module_ = modName
                                                    , package = m.package
                                                    , annotation = dummyAnnotation -- TODO
                                                    }
                                        )
                        in
                        when m.exports is
                            CanonicalAst.ExportEverything _ ->
                                normalizedDefs

                            CanonicalAst.Export exportDict ->
                                let
                                    names =
                                        Dict.keys exportDict
                                in
                                Array.keepIf (\d -> Array.member d.name names) normalizedDefs
                    )
                |> Maybe.withDefault [] -- In theory, this will never happen
    in
    -- TODO: What if there are multiple modules of the same name from different packages?
    Dict.set
        (ModuleName.toString modName)
        (Array.foldl
            (\def acc ->
                Dict.set
                    def.name
                    { first =
                        { module_ = def.module_
                        , package = def.package
                        , annotation = def.annotation
                        }
                    , rest = []
                    }
                    acc
            )
            Dict.empty
            values
        )
        qv


extractExposedVals : Dict String CanonicalAst.Module -> ParseAst.Import -> Dict String Expression.ScopeEntry -> Dict String Expression.ScopeEntry
extractExposedVals canModules mod scope =
    let
        modName =
            mod.module_.value

        values =
            -- TODO: de-duplicate
            Dict.get (ModuleName.toString modName) canModules
                |> Maybe.map
                    (\m ->
                        let
                            normalizedDefs =
                                CanonicalAst.flattenDecls m.decls
                                    |> Array.map
                                        (\d ->
                                            when d is
                                                CanonicalAst.Def { name } ->
                                                    { name = name.value
                                                    , module_ = modName
                                                    , package = m.package
                                                    , annotation = dummyAnnotation -- TODO
                                                    , position = { start = name.start, end = name.end}
                                                    }

                                                CanonicalAst.TypedDef { name } ->
                                                    { name = name.value
                                                    , module_ = modName
                                                    , package = m.package
                                                    , annotation = dummyAnnotation -- TODO
                                                    -- TODO: add located -> region function
                                                    , position = { start = name.start, end = name.end}
                                                    }
                                        )
                        in
                        when m.exports is
                            CanonicalAst.ExportEverything _ ->
                                normalizedDefs

                            CanonicalAst.Export exportDict ->
                                let
                                    names =
                                        Dict.keys exportDict
                                in
                                Array.keepIf (\d -> Array.member d.name names) normalizedDefs
                    )
                |> Maybe.withDefault [] -- In theory, this will never happen
    in
    Array.foldl
        (\def acc ->
            let
                entry =
                    Expression.Imported
                        { entry = 
                            { module_ = def.module_
                            , package = def.package
                            , annotation = def.annotation
                            }
                        , position = def.position
                        }
            in
            -- TODO: what about conflicts?
            Dict.set def.name entry acc
        )
        scope
        values


dummyAnnotation : CanonicalAst.Annotation
dummyAnnotation =
    { freeVars = Set.empty
    , tipe = CanonicalAst.TVar "x"
    }


{-| Canonicalize exports from a module.
-}
canonicalizeExports : ParseAst.Exposing -> SourcePosition.Region -> Result Error CanonicalAst.Exports
canonicalizeExports exposings region =
    when exposings is
        ParseAst.Open ->
            Ok (CanonicalAst.ExportEverything region)

        ParseAst.Explicit _ ->
            Err PlaceholderError


{-| Canonicalize a single union
-}
canonicalizeUnion : Expression.Context -> ParseAst.Union -> Result Error CanonicalAst.Union
canonicalizeUnion context value =
    Ok
        { name = value.name.value
        , vars = Array.map .value value.vars
        , alts =
            Array.indexedMap
                (\idx { value = variant } ->
                    { name = variant.name.value
                    , index = idx
                    -- TODO: canonicalize types
                    , arg = Nothing
                    }
                )
                value.variants
        , opts =
            when value.variants is
                [ { value = { payload = Just _ } } ] ->
                    CanonicalAst.Unbox

                _ ->
                    if Array.any (\var -> var.value.payload /= Nothing ) value.variants then
                        CanonicalAst.Normal

                    else
                        CanonicalAst.Enum
        }


{-| Canonicalize a single definition (value).
-}
canonicalizeDef : Expression.Context -> ParseAst.Value -> Result Error CanonicalAst.Def
canonicalizeDef context value =
    when value.signature is
        Nothing ->
            Result.map2
                (\params body ->
                    CanonicalAst.Def
                        { name = value.name
                        , params = params
                        , body = body
                        }
                )
                (Array.foldl
                    (\pat acc ->
                        Result.andThen
                            (\current ->
                                Result.map
                                    (\p -> Array.append current [p])
                                    (Expression.canonicalizePattern context pat)
                            )
                            acc
                    )
                    (Ok [])
                    value.args
                    |> Result.mapError ExpressionError
                )
                (Expression.canonicalize context value.body |> Result.mapError ExpressionError)

        Just _ ->
            Err PlaceholderError


{-| Canonicalize effects.
-}
canonicalizeEffects : ParseAst.Effects -> Result Error CanonicalAst.Effects
canonicalizeEffects effects =
    when effects is
        ParseAst.NoEffects ->
            Ok CanonicalAst.NoEffects

        _ ->
            Err PlaceholderError


{-| Canonicalize dependencies of a module.
Processes all requires and imports in order, canonicalizing each dependency.
-}
canonicalizeDependencies :
    PackageName ->
    Dict String SourceModule ->
    Dict String CanonicalAst.Module ->
    Set String ->
    ParseAst.Module ->
    Result Error (Dict String CanonicalAst.Module)
canonicalizeDependencies pkg parsedModules modules recursionStack ast =
    let
        depNames =
            getModuleDependencies ast
    in
    Array.foldl
        (\depName accResult ->
            Result.andThen
                (\currentModules ->
                    let
                        depNameStr =
                            ModuleName.toString depName
                    in
                    if Dict.member depNameStr currentModules then
                        Ok currentModules

                    else if Set.member depNameStr recursionStack then
                        Err (CyclicDependency depName)

                    else
                        when Dict.get depNameStr parsedModules is
                            Just parsedDep ->
                                canonicalizeModule
                                    pkg
                                    parsedModules
                                    currentModules
                                    (Set.set depNameStr recursionStack)
                                    parsedDep

                            Nothing ->
                                Err (ModuleNotFound depName)
                )
                accResult
        )
        (Ok modules)
        depNames


{-| Extract all module dependencies from requires and imports.
-}
getModuleDependencies : ParseAst.Module -> Array ModuleName
getModuleDependencies mod =
    when mod is
        ParseAst.Implementation impl ->
            let
                reqNames =
                    Array.map (\reqLoc -> reqLoc.value.module_.value) impl.requires

                impNames =
                    Array.map (\impLoc -> impLoc.value.module_.value) impl.imports
            in
            Array.append reqNames impNames

        ParseAst.Signature _ ->
            []


canonicalizeType : ParseAst.Type -> Result Error CanonicalAst.Type
canonicalizeType tipe =
    when tipe.value is
        ParseAst.TLambda lambda ->
            Result.map2
                (\from to -> CanonicalAst.TLambda { from = from, to = to })
                (canonicalizeType lambda.from)
                (canonicalizeType lambda.to)

        ParseAst.TVar name ->
            Ok (CanonicalAst.TVar name)

        ParseAst.TType { name, args } ->
            Err PlaceholderError

        ParseAst.TTypeQual { varRegion, qualifier, name, args } ->
            Err PlaceholderError

        ParseAst.TRecord { fields, extending } ->
            let
                canFieldResult =
                    Array.foldl
                        (\field acc ->
                            Result.andThen
                                (\canFields ->
                                    canonicalizeType field.signature
                                        |> Result.map
                                            (\canField ->
                                                Dict.set
                                                    field.field.value
                                                    canField
                                                    canFields
                                            )
                                )
                                acc
                        )
                        (Ok Dict.empty)
                        fields
            in
            Result.map
                (\canFields ->
                    CanonicalAst.TRecord
                        { fields = canFields
                        , alias = Maybe.map .value extending
                        }
                )
                canFieldResult

        ParseAst.TParens pTipe ->
            canonicalizeType pTipe
