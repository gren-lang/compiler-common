module Compiler.Canonicalize.Module exposing
    ( SourceModule
    , Context
    , emptyContext
    , Error (..)
    , canonicalize
    )

import Compiler.Ast.Source as ParseAst
import Compiler.Ast.Canonical as CanonicalAst
import Compiler.Canonicalize.Expression as Expression
import Compiler.PackageName as PackageName exposing (PackageName)
import Compiler.ModuleName as ModuleName exposing (ModuleName)
import Compiler.SourcePosition as SourcePosition
import Compiler.Parse.Number as Number
import Dict exposing (Dict)
import Array
import Set exposing (Set)


type alias SourceModule =
    { package : PackageName
    , ast : ParseAst.Module
    }


type alias Context =
    { signatures : Dict String CanonicalAst.Signature
    , modules : Dict String CanonicalAst.Module
    }


emptyContext : Context
emptyContext =
    { signatures = Dict.empty
    , modules = Dict.empty
    }


type Error
    = PlaceholderError
    | ExpressionError Expression.Error
    | CyclicDependency ModuleName
    | ModuleNotFound ModuleName


{-| Takes in a `Dict` of parsed modules, where the `String` key represents a module name, and returns
a `Dict` of canonicalized modules, or `Error`
-}
canonicalize : PackageName -> Dict String SourceModule -> Context -> Result Error Context
canonicalize pkg parsedModules context =
    Dict.foldl
        (\key parsedModule resultAcc ->
            Result.andThen
                (\contextAcc ->
                    canonicalizeModule pkg parsedModules contextAcc Set.empty parsedModule []
                )
                resultAcc
        )
        (Ok context)
        parsedModules


{-| Canonicalize a full module, ensuring dependencies are canonicalized first.
-}
canonicalizeModule :
    PackageName ->
    Dict String SourceModule ->
    Context ->
    Set String ->
    SourceModule ->
    Array ModuleName ->
    Result Error Context
canonicalizeModule pkg parsedModules context recursionStack sourceModule args =
    let
        modName =
            Array.foldl
                ModuleName.withParameter
                (ParseAst.moduleName sourceModule.ast).value
                args

        modNameString =
            ModuleName.toString modName
    in
    if Dict.member modNameString context.modules || Dict.member modNameString context.signatures then
        Ok context

    else if Set.member modNameString recursionStack then
        Err (CyclicDependency modName)

    else
        let
            newStack =
                Set.set modNameString recursionStack

            appliedModule =
                when args is
                    [] ->
                        sourceModule

                    _ ->
                        -- TODO: verify module signatures
                        applyModuleParameters args sourceModule
        in
        canonicalizeDependencies pkg parsedModules context newStack appliedModule.ast
            |> Result.andThen (canonicalizeModuleContent modName pkg appliedModule)


{-| Canonicalize dependencies of a module.
Processes all requires and imports in order, canonicalizing each dependency.
-}
canonicalizeDependencies :
    PackageName ->
    Dict String SourceModule ->
    Context ->
    Set String ->
    ParseAst.Module ->
    Result Error Context
canonicalizeDependencies pkg parsedModules context recursionStack ast =
    let
        depNames =
            getModuleDependencies ast
    in
    Array.foldl
        (\dep accResult ->
            Result.andThen
                (\newContext ->
                    let
                        depNameStr =
                            ModuleName.toString dep.name
                    in
                    when Dict.get depNameStr parsedModules is
                        Just parsedDep ->
                            canonicalizeModule
                                pkg
                                parsedModules
                                newContext
                                recursionStack
                                parsedDep
                                dep.args

                        Nothing ->
                            Err (ModuleNotFound dep.name)
                )
                accResult
        )
        (Ok context)
        depNames


{-| Extract all module dependencies from requires and imports.
-}
getModuleDependencies : ParseAst.Module -> Array { name : ModuleName, args : Array ModuleName }
getModuleDependencies mod =
    when mod is
        ParseAst.Implementation impl ->
            let
                reqNames =
                    Array.map
                        (\reqLoc -> { name = reqLoc.value.module_.value, args = [] })
                        impl.requires

                impNames =
                    Array.mapAndFlatten
                        (\reqLoc ->
                            when reqLoc.value.args is
                                [] ->
                                    [ { name = reqLoc.value.module_.value, args = [] } ]

                                filled ->
                                    (Array.map
                                        (\arg ->
                                            { name = arg.value, args = [] }
                                        )
                                        filled
                                    ) ++
                                    [ { name = reqLoc.value.module_.value, args = [] }
                                    , { name = reqLoc.value.module_.value, args = Array.map .value filled }
                                    ]
                                
                        )
                        impl.imports
            in
            Array.append reqNames impNames

        ParseAst.Signature _ ->
            -- TODO
            []


{-| Canonicalize module content.
-}
canonicalizeModuleContent : ModuleName -> PackageName -> SourceModule -> Context -> Result Error Context
canonicalizeModuleContent realName pkg parsedModule context =
    when parsedModule.ast is
        ParseAst.Implementation impl ->
            let
                canBinops =
                    Array.foldl
                        (\bin acc ->
                            let
                                binOp =
                                    bin.value
                            in
                            Dict.set
                                binOp.symbol
                                { name = binOp.fn
                                , associativity = binOp.associativity
                                , precedence = binOp.precedence
                                }
                                acc
                        )
                        Dict.empty
                        impl.binops

                expressionContext =
                    createExpressionContext pkg context impl

                exportsResult =
                    canonicalizeExports impl.exports { start = impl.name.start, end = impl.name.end }

                effectsResult =
                    canonicalizeEffects impl.effects

                externalAliases =
                    Array.foldl
                        (\{ value = imp } dict ->
                            when Dict.get (ModuleName.toString imp.module_.value) context.modules is
                                Nothing ->
                                    dict

                                Just canMod ->
                                    when canMod.exports is
                                        CanonicalAst.Export _ ->
                                            -- TODO: common code for handling exports
                                            dict

                                        CanonicalAst.ExportEverything _ ->
                                            -- TODO: duplicates?
                                            canMod.aliases
                                                |> Dict.map
                                                    (\name ali ->
                                                        CanonicalAst.TAlias
                                                            { home = canMod.name
                                                            , name = name
                                                            , fields =
                                                                ali.vars
                                                                    |> Array.map
                                                                        (\var ->
                                                                            { name = var
                                                                            , tipe = CanonicalAst.TVar var
                                                                            }
                                                                        )
                                                            , aliasTipe = CanonicalAst.Holey ali.tipe
                                                            }
                                                    )
                                                |> Dict.union dict
                        )
                        Dict.empty
                        impl.imports

                typeAliasResult =
                    Array.foldl
                        (\alias acc ->
                            Result.andThen
                                (\canAliases ->
                                    Result.map
                                        (\canTipe ->
                                            Dict.set
                                                alias.value.value.name.value
                                                { vars = Array.map .value alias.value.value.vars
                                                , tipe = canTipe
                                                }
                                                canAliases
                                        )
                                        (canonicalizeType externalAliases alias.value.value.type_)
                                )
                                acc
                        )
                        (Ok Dict.empty)
                        impl.aliases

                unionResult =
                    Array.foldl
                        (\union acc ->
                            Result.andThen
                                (\unions ->
                                    canonicalizeUnion expressionContext union.value.value
                                        |> Result.map
                                            (\u ->
                                                Dict.set
                                                    union.value.value.name.value
                                                    u
                                                    unions
                                            )
                                )
                                acc
                        )
                        (Ok Dict.empty)
                        impl.unions

                contextWithUnions =
                    unionResult
                        |> Result.map
                            (\us ->
                                Dict.values us
                                    |> Array.foldl
                                        (\union acc ->
                                            Array.foldl
                                                (\variant acc2 ->
                                                    Dict.set
                                                        variant.name
                                                        { first =
                                                             { module_ = realName
                                                             , package = impl.package
                                                             , union = union
                                                             , name = variant.name
                                                             , index = variant.index
                                                             , argType = variant.arg
                                                             }
                                                        -- TODO: what about collisions?
                                                        , rest = []
                                                        }
                                                        acc2
                                                )
                                                acc
                                                union.alts
                                        )
                                        Dict.empty
                            )
                        |> Result.map
                            (\ctors ->
                                -- TODO: What about collisions?
                                { expressionContext | scopedCtors = Dict.union ctors expressionContext.scopedCtors }
                            )
                        -- TODO: swallows error
                        |> Result.withDefault expressionContext

                decsResult =
                    Array.foldl
                        (\decl declsResult ->
                            Result.andThen
                                (\decls ->
                                    canonicalizeDef contextWithUnions decl.value.value
                                        |> Result.map (\d -> CanonicalAst.Declare { def = d, decls = decls })
                                )
                                declsResult
                        )
                        (Ok CanonicalAst.SaveTheEnvironment)
                        impl.values

            in
            Ok
                (\canonicalExports canonicalEffects canAlias canUnions canDecls ->
                    { name = realName
                    , package = impl.package
                    , exports = canonicalExports
                    , decls = canDecls
                    , unions = canUnions
                    , aliases = canAlias
                    , binops = canBinops
                    , effects = canonicalEffects
                    }
                )
                |> Result.andMap exportsResult
                |> Result.andMap effectsResult
                |> Result.andMap typeAliasResult
                |> Result.andMap unionResult
                |> Result.andMap decsResult
                |> Result.map
                    (\newModule ->
                        { context | modules = Dict.set (ModuleName.toString newModule.name) newModule context.modules }
                    )

        ParseAst.Signature sig ->
            let
                typeNames =
                    Array.map (\v -> v.value.value.name.value) sig.types

                localTypes =
                    Array.foldl
                        (\name dict ->
                            Dict.set
                                name
                                (CanonicalAst.TType
                                    { home = sig.name.value
                                    , name = name
                                    , vars = []
                                    }
                                )
                                dict
                        )
                        Dict.empty
                        typeNames

                canResult =
                    Array.foldl
                        (\value accResult ->
                            Result.andThen
                                (\acc ->
                                    canonicalizeType localTypes value.value.value.signature
                                        |> Result.map
                                            (\t ->
                                                Dict.set
                                                    value.value.value.name.value
                                                    t
                                                    acc
                                            )
                                )
                                accResult
                        )
                        (Ok Dict.empty)
                        sig.values

            in
            Result.map
                (\canValues ->
                    let
                        sigModule =
                            { name = sig.name.value
                            , package = sig.package
                            , typeNames = typeNames
                            , values = canValues
                            }
                    in
                    { context | signatures = Dict.set (ModuleName.toString sig.name.value) sigModule context.signatures }
                )
                canResult


createExpressionContext : PackageName -> Context -> ParseAst.ModuleImplementation -> Expression.Context
createExpressionContext pkg moduleContext parsedModule =
    let
        topLevelScope =
            Array.foldl
                (\val dict ->
                    Dict.set
                        val.value.value.name.value
                        (Expression.Local { position = { start = val.start, end = val.end } })
                        dict
                )
                Dict.empty
                parsedModule.values

        qualifiedVarsFromImplementations =
            Array.foldl
                (extractQualifiedVarsImplHelper moduleContext.modules)
                Dict.empty
                (Array.map .value parsedModule.imports)

        qualifiedVars =
            Array.foldl
                (extractQualifiedVarsSigHelper moduleContext.signatures)
                qualifiedVarsFromImplementations
                (Array.map .value parsedModule.requires)

        scopedCtorsFromImports =
            Array.foldl
                (\val dict ->
                    when Dict.get (ModuleName.toString val.value.module_.value) moduleContext.modules is
                        Nothing ->
                            dict

                        Just canMod ->
                            when canMod.exports is
                                CanonicalAst.Export _ ->
                                    dict

                                CanonicalAst.ExportEverything _ ->
                                    Dict.foldl
                                        (\_ union acc ->
                                            Array.foldl
                                                (\variant acc2 ->
                                                    Dict.set
                                                        variant.name
                                                        { first =
                                                             { module_ = canMod.name
                                                             , package = canMod.package
                                                             , union = union
                                                             , name = variant.name
                                                             , index = variant.index
                                                             , argType = variant.arg
                                                             }
                                                        -- TODO: what about collisions?
                                                        , rest = []
                                                        }
                                                        acc2
                                                )
                                                acc
                                                union.alts
                                        )
                                        dict
                                        canMod.unions
                )
                Dict.empty
                parsedModule.imports
    in
    { pkg = pkg
    , currentModule = parsedModule.name.value
    , qualifiedVars = qualifiedVars
    , qualifiedCtors = Dict.empty
    , scope =
        Array.foldl
            (extractExposedVals moduleContext.modules)
            topLevelScope
            (Array.map .value parsedModule.imports) -- TODO: de-duplicate
    , scopedCtors = scopedCtorsFromImports
    , scopedOperators =
        parsedModule.binops
            |> Array.map .value
            |> Array.foldl
                (\infix acc ->
                    Dict.set infix.symbol { moduleName = parsedModule.name.value, operator = infix } acc
                )
                Dict.empty
    }


extractQualifiedVarsImplHelper : Dict String CanonicalAst.Module -> ParseAst.Import -> Dict String (Dict String (Expression.OneOrMore Expression.QualifiedEntry)) -> Dict String (Dict String (Expression.OneOrMore Expression.QualifiedEntry))
extractQualifiedVarsImplHelper canModules mod qv =
    let
        modName =
            mod.module_.value

        qualifier =
            mod.alias
                |> Maybe.withDefault modName

        values =
            Dict.get (ModuleName.toString modName) canModules
                |> Maybe.map
                    (\m ->
                        let
                            normalizedDefs =
                                CanonicalAst.flattenDecls m.decls
                                    |> Array.map
                                        (\d ->
                                            when d is
                                                CanonicalAst.Def { name } ->
                                                    { name = name.value
                                                    , module_ = modName
                                                    , package = m.package
                                                    , annotation = dummyAnnotation -- TODO
                                                    }

                                                CanonicalAst.TypedDef { name } ->
                                                    { name = name.value
                                                    , module_ = modName
                                                    , package = m.package
                                                    , annotation = dummyAnnotation -- TODO
                                                    }
                                        )
                        in
                        when m.exports is
                            CanonicalAst.ExportEverything _ ->
                                normalizedDefs

                            CanonicalAst.Export exportDict ->
                                let
                                    names =
                                        Dict.keys exportDict
                                in
                                Array.keepIf (\d -> Array.member d.name names) normalizedDefs
                    )
                |> Maybe.withDefault [] -- In theory, this will never happen
    in
    -- TODO: What if there are multiple modules of the same name from different packages?
    Dict.set
        (ModuleName.toString qualifier)
        (Array.foldl
            (\def acc ->
                Dict.set
                    def.name
                    { first =
                        { module_ = def.module_
                        , package = def.package
                        , annotation = def.annotation
                        }
                    , rest = []
                    }
                    acc
            )
            Dict.empty
            values
        )
        qv


extractQualifiedVarsSigHelper : Dict String CanonicalAst.Signature -> ParseAst.Require -> Dict String (Dict String (Expression.OneOrMore Expression.QualifiedEntry)) -> Dict String (Dict String (Expression.OneOrMore Expression.QualifiedEntry))
extractQualifiedVarsSigHelper canSignatures mod qv =
    let
        modName =
            mod.module_.value

        qualifier =
            mod.alias
                |> Maybe.withDefault modName

        values =
            Dict.get (ModuleName.toString modName) canSignatures
                |> Maybe.map
                    (\m ->
                        Dict.foldl
                            (\name value acc ->
                                Array.pushLast
                                    { name = name
                                    , module_ = modName
                                    , package = m.package
                                    , annotation = dummyAnnotation -- TODO
                                    }
                                    acc
                            )
                            []
                            m.values
                    )
                |> Maybe.withDefault [] -- In theory, this will never happen
    in
    -- TODO: What if there are multiple modules of the same name from different packages?
    Dict.set
        (ModuleName.toString qualifier)
        (Array.foldl
            (\def acc ->
                Dict.set
                    def.name
                    { first =
                        { module_ = def.module_
                        , package = def.package
                        , annotation = def.annotation
                        }
                    , rest = []
                    }
                    acc
            )
            Dict.empty
            values
        )
        qv


extractExposedVals : Dict String CanonicalAst.Module -> ParseAst.Import -> Dict String Expression.ScopeEntry -> Dict String Expression.ScopeEntry
extractExposedVals canModules mod scope =
    let
        modName =
            mod.module_.value

        values =
            -- TODO: de-duplicate
            Dict.get (ModuleName.toString modName) canModules
                |> Maybe.map
                    (\m ->
                        let
                            normalizedDefs =
                                CanonicalAst.flattenDecls m.decls
                                    |> Array.map
                                        (\d ->
                                            when d is
                                                CanonicalAst.Def { name } ->
                                                    { name = name.value
                                                    , module_ = modName
                                                    , package = m.package
                                                    , annotation = dummyAnnotation -- TODO
                                                    , position = { start = name.start, end = name.end}
                                                    }

                                                CanonicalAst.TypedDef { name } ->
                                                    { name = name.value
                                                    , module_ = modName
                                                    , package = m.package
                                                    , annotation = dummyAnnotation -- TODO
                                                    -- TODO: add located -> region function
                                                    , position = { start = name.start, end = name.end}
                                                    }
                                        )
                        in
                        when m.exports is
                            CanonicalAst.ExportEverything _ ->
                                normalizedDefs

                            CanonicalAst.Export exportDict ->
                                let
                                    names =
                                        Dict.keys exportDict
                                in
                                Array.keepIf (\d -> Array.member d.name names) normalizedDefs
                    )
                |> Maybe.withDefault [] -- In theory, this will never happen
    in
    Array.foldl
        (\def acc ->
            let
                entry =
                    Expression.Imported
                        { entry = 
                            { module_ = def.module_
                            , package = def.package
                            , annotation = def.annotation
                            }
                        , position = def.position
                        }
            in
            -- TODO: what about conflicts?
            Dict.set def.name entry acc
        )
        scope
        values


dummyAnnotation : CanonicalAst.Annotation
dummyAnnotation =
    { freeVars = Set.empty
    , tipe = CanonicalAst.TVar "x"
    }


{-| Canonicalize exports from a module.
-}
canonicalizeExports : ParseAst.Exposing -> SourcePosition.Region -> Result Error CanonicalAst.Exports
canonicalizeExports exposings region =
    when exposings is
        ParseAst.Open ->
            Ok (CanonicalAst.ExportEverything region)

        ParseAst.Explicit _ ->
            Err PlaceholderError


{-| Canonicalize a single union
-}
canonicalizeUnion : Expression.Context -> ParseAst.Union -> Result Error CanonicalAst.Union
canonicalizeUnion context value =
    Ok
        { name = value.name.value
        , vars = Array.map .value value.vars
        , alts =
            Array.indexedMap
                (\idx { value = variant } ->
                    { name = variant.name.value
                    , index = idx
                    -- TODO: canonicalize types
                    , arg = Nothing
                    }
                )
                value.variants
        , opts =
            when value.variants is
                [ { value = { payload = Just _ } } ] ->
                    CanonicalAst.Unbox

                _ ->
                    if Array.any (\var -> var.value.payload /= Nothing ) value.variants then
                        CanonicalAst.Normal

                    else
                        CanonicalAst.Enum
        }


{-| Canonicalize a single definition (value).
-}
canonicalizeDef : Expression.Context -> ParseAst.Value -> Result Error CanonicalAst.Def
canonicalizeDef context value =
    when value.signature is
        Nothing ->
            Result.map2
                (\params body ->
                    CanonicalAst.Def
                        { name = value.name
                        , params = params
                        , body = body
                        }
                )
                (Array.foldl
                    (\pat acc ->
                        Result.andThen
                            (\current ->
                                Result.map
                                    (\p -> Array.append current [p])
                                    (Expression.canonicalizePattern context pat)
                            )
                            acc
                    )
                    (Ok [])
                    value.args
                    |> Result.mapError ExpressionError
                )
                (Expression.canonicalize context value.body |> Result.mapError ExpressionError)

        Just _ ->
            Err PlaceholderError


{-| Canonicalize effects.
-}
canonicalizeEffects : ParseAst.Effects -> Result Error CanonicalAst.Effects
canonicalizeEffects effects =
    when effects is
        ParseAst.NoEffects ->
            Ok CanonicalAst.NoEffects

        _ ->
            Err PlaceholderError



canonicalizeType : Dict String CanonicalAst.Type -> ParseAst.Type -> Result Error CanonicalAst.Type
canonicalizeType recognizedTypes tipe =
    when tipe.value is
        ParseAst.TLambda lambda ->
            Result.map2
                (\from to -> CanonicalAst.TLambda { from = from, to = to })
                (canonicalizeType recognizedTypes lambda.from)
                (canonicalizeType recognizedTypes lambda.to)

        ParseAst.TVar name ->
            Ok (CanonicalAst.TVar name)

        ParseAst.TType { name, args } ->
            when Dict.get name.value recognizedTypes is
                Just t ->
                    Ok t

                Nothing ->
                    Err PlaceholderError

        ParseAst.TTypeQual { varRegion, qualifier, name, args } ->
            Err PlaceholderError

        ParseAst.TRecord { fields, extending } ->
            let
                canFieldResult =
                    Array.foldl
                        (\field acc ->
                            Result.andThen
                                (\canFields ->
                                    canonicalizeType recognizedTypes field.signature
                                        |> Result.map
                                            (\canField ->
                                                Dict.set
                                                    field.field.value
                                                    canField
                                                    canFields
                                            )
                                )
                                acc
                        )
                        (Ok Dict.empty)
                        fields
            in
            Result.map
                (\canFields ->
                    CanonicalAst.TRecord
                        { fields = canFields
                        , alias = Maybe.map .value extending
                        }
                )
                canFieldResult

        ParseAst.TParens pTipe ->
            canonicalizeType recognizedTypes pTipe


-- APPLY MODULE PARAMS


applyModuleParameters : Array ModuleName -> SourceModule -> SourceModule
applyModuleParameters args sourceModule =
    when sourceModule.ast is
        ParseAst.Signature _ ->
            -- TODO: shouldn't happen
            sourceModule

        ParseAst.Implementation impl ->
            let
                newImports =
                    Array.map2
                        (\arg req ->
                            let
                                argNameLength =
                                    ModuleName.toString arg
                                        |> String.count
                            in
                            SourcePosition.at
                                req.start
                                req.end
                                { module_ =
                                    SourcePosition.at
                                        req.value.module_.start
                                        { req.value.module_.start
                                            | col = req.value.module_.start.col + argNameLength
                                        }
                                        arg
                                , args = []
                                , alias = req.value.alias
                                , expose = req.value.expose
                                }
                        )
                        args
                        impl.requires
            in
            { package = sourceModule.package
            , ast = ParseAst.Implementation
                { impl
                    | requires = []
                    , imports = newImports ++ impl.imports
                }
            }
