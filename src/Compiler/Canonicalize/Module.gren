module Compiler.Canonicalize.Module exposing
    ( SourceModule
    , Context
    , emptyContext
    , Error (..)
    , canonicalize
    )

import Compiler.Ast.Source as ParseAst
import Compiler.Ast.Canonical as CanonicalAst
import Compiler.Canonicalize.Expression as Expression
import Compiler.Canonicalize.ScopedEntries as ScopedEntries exposing (ScopedEntries)
import Compiler.PackageName as PackageName exposing (PackageName)
import Compiler.ModuleName as ModuleName exposing (ModuleName)
import Compiler.SourcePosition as SourcePosition
import Compiler.Parse.Number as Number
import Dict exposing (Dict)
import Array
import Set exposing (Set)


type alias SourceModule =
    { package : PackageName
    , ast : ParseAst.Module
    }


type alias Context =
    { signatures : Dict String CanonicalAst.Signature
    , modules : Dict String CanonicalAst.Module
    }


emptyContext : Context
emptyContext =
    { signatures = Dict.empty
    , modules = Dict.empty
    }


type Error
    = PlaceholderError
    | ExpressionError Expression.Error
    | CyclicDependency ModuleName
    | ModuleNotFound ModuleName
    | ExposedTwice (SourcePosition.Located String)
    | ExposeNotFound (SourcePosition.Located String)


{-| Takes in a `Dict` of parsed modules, where the `String` key represents a module name, and returns
a `Dict` of canonicalized modules, or `Error`
-}
canonicalize : PackageName -> Dict String SourceModule -> Context -> Result Error Context
canonicalize pkg parsedModules context =
    Dict.foldl
        (\key parsedModule resultAcc ->
            Result.andThen
                (\contextAcc ->
                    canonicalizeModule pkg parsedModules contextAcc Set.empty parsedModule []
                )
                resultAcc
        )
        (Ok context)
        parsedModules


{-| Canonicalize a full module, ensuring dependencies are canonicalized first.
-}
canonicalizeModule :
    PackageName ->
    Dict String SourceModule ->
    Context ->
    Set String ->
    SourceModule ->
    Array ModuleName ->
    Result Error Context
canonicalizeModule pkg parsedModules context recursionStack sourceModule args =
    let
        modName =
            Array.foldl
                ModuleName.withParameter
                (ParseAst.moduleName sourceModule.ast).value
                args

        modNameString =
            ModuleName.toString modName
    in
    if Dict.member modNameString context.modules || Dict.member modNameString context.signatures then
        Ok context

    else if Set.member modNameString recursionStack then
        Err (CyclicDependency modName)

    else
        let
            newStack =
                Set.set modNameString recursionStack

            appliedModule =
                when args is
                    [] ->
                        sourceModule

                    _ ->
                        -- TODO: verify module signatures
                        applyModuleParameters args sourceModule
        in
        canonicalizeDependencies pkg parsedModules context newStack appliedModule.ast
            |> Result.andThen (canonicalizeModuleContent modName pkg appliedModule)


{-| Canonicalize dependencies of a module.
Processes all requires and imports in order, canonicalizing each dependency.
-}
canonicalizeDependencies :
    PackageName ->
    Dict String SourceModule ->
    Context ->
    Set String ->
    ParseAst.Module ->
    Result Error Context
canonicalizeDependencies pkg parsedModules context recursionStack ast =
    let
        depNames =
            getModuleDependencies ast
    in
    Array.foldl
        (\dep accResult ->
            Result.andThen
                (\newContext ->
                    let
                        depNameStr =
                            ModuleName.toString dep.name
                    in
                    when Dict.get depNameStr parsedModules is
                        Just parsedDep ->
                            canonicalizeModule
                                pkg
                                parsedModules
                                newContext
                                recursionStack
                                parsedDep
                                dep.args

                        Nothing ->
                            Err (ModuleNotFound dep.name)
                )
                accResult
        )
        (Ok context)
        depNames


{-| Extract all module dependencies from requires and imports.
-}
getModuleDependencies : ParseAst.Module -> Array { name : ModuleName, args : Array ModuleName }
getModuleDependencies mod =
    when mod is
        ParseAst.Implementation impl ->
            let
                reqNames =
                    Array.map
                        (\reqLoc -> { name = reqLoc.value.module_.value, args = [] })
                        impl.requires

                impNames =
                    Array.mapAndFlatten
                        (\reqLoc ->
                            when reqLoc.value.args is
                                [] ->
                                    [ { name = reqLoc.value.module_.value, args = [] } ]

                                filled ->
                                    (Array.map
                                        (\arg ->
                                            { name = arg.value, args = [] }
                                        )
                                        filled
                                    ) ++
                                    [ { name = reqLoc.value.module_.value, args = [] }
                                    , { name = reqLoc.value.module_.value, args = Array.map .value filled }
                                    ]
                                
                        )
                        impl.imports
            in
            Array.append reqNames impNames

        ParseAst.Signature _ ->
            -- TODO
            []


{-| Canonicalize module content.
-}
canonicalizeModuleContent : ModuleName -> PackageName -> SourceModule -> Context -> Result Error Context
canonicalizeModuleContent realName pkg parsedModule context =
    when parsedModule.ast is
        ParseAst.Implementation impl ->
            let
                canBinops =
                    Array.foldl
                        (\bin acc ->
                            let
                                binOp =
                                    bin.value
                            in
                            Dict.set
                                binOp.symbol
                                { name = binOp.fn
                                , associativity = binOp.associativity
                                , precedence = binOp.precedence
                                }
                                acc
                        )
                        Dict.empty
                        impl.binops

                expressionContext =
                    createExpressionContext pkg context impl

                exportsResult =
                    -- TODO: is the constructed region correct?
                    canonicalizeExports impl { start = impl.name.start, end = impl.name.end }

                effectsResult =
                    canonicalizeEffects realName scopedTypes parsedLocalTypes impl.effects

                parsedLocalTypeAliases =
                    Array.foldl
                        (\alias acc ->
                            Dict.set
                                alias.value.value.name.value
                                (TypeAlias alias.value.value)
                                acc
                        )
                        Dict.empty
                        impl.aliases

                parsedLocalTypes =
                    Array.foldl
                        (\union acc ->
                            Dict.set
                                union.value.value.name.value
                                (CustomType (Array.map .value union.value.value.vars))
                                acc
                        )
                        parsedLocalTypeAliases
                        impl.unions

                externalAliases =
                    Array.foldl
                        (\{ value = imp } endScope ->
                            when Dict.get (ModuleName.toString imp.module_.value) context.modules is
                                Nothing ->
                                    endScope

                                Just canMod ->
                                    let
                                        aliases =
                                            Dict.foldl
                                                (\name ali acc ->
                                                    Array.pushLast
                                                        { home = canMod.name
                                                        , name = name
                                                        , tipe =
                                                            (CanonicalAst.TAlias
                                                                { home = canMod.name
                                                                , name = name
                                                                , fields =
                                                                    ali.vars
                                                                        |> Array.map
                                                                            (\var ->
                                                                                { name = var
                                                                                , tipe = CanonicalAst.TVar var
                                                                                }
                                                                            )
                                                                , aliasTipe = CanonicalAst.Holey ali.tipe
                                                                }
                                                            )
                                                        }
                                                        acc
                                                )
                                                []
                                                canMod.aliases

                                        entries =
                                            Dict.foldl
                                                (\name union acc ->
                                                    Array.pushLast
                                                        { home = canMod.name
                                                        , name = name
                                                        , tipe =
                                                            (CanonicalAst.TType
                                                                { home = canMod.name
                                                                , name = name
                                                                , vars = Array.map CanonicalAst.TVar union.vars
                                                                }
                                                            )
                                                        }
                                                        acc
                                                )
                                                aliases
                                                canMod.unions

                                        scopedEntriesQualified =
                                            Array.foldl
                                                (\t acc -> ScopedEntries.addQualified t.home t.name t.tipe acc)
                                                ScopedEntries.empty
                                                entries

                                        exposed =
                                            when canMod.exports is
                                                CanonicalAst.Export exports ->
                                                    Array.keepIf (\a -> Dict.member a.name exports) entries

                                                CanonicalAst.ExportEverything _ ->
                                                    entries
                                    in
                                    Array.foldl
                                        (\t acc -> ScopedEntries.add t.name t.tipe acc)
                                        scopedEntriesQualified
                                        exposed
                                        |> ScopedEntries.union endScope
                        )
                        ScopedEntries.empty
                        impl.imports

                typeAliasResult =
                    Array.foldl
                        (\alias acc ->
                            Result.andThen
                                (\canAliases ->
                                    Result.map
                                        (\canTipe ->
                                            Dict.set
                                                alias.value.value.name.value
                                                { vars = Array.map .value alias.value.value.vars
                                                , tipe = canTipe
                                                }
                                                canAliases
                                        )
                                        (canonicalizeType realName externalAliases parsedLocalTypes alias.value.value.type_)
                                )
                                acc
                        )
                        (Ok Dict.empty)
                        impl.aliases

                scopedTypes =
                    when typeAliasResult is
                        Err _ ->
                            externalAliases

                        Ok ts ->
                            Dict.foldl
                                (\name value scope ->
                                    ScopedEntries.add name value.tipe scope
                                )
                                externalAliases
                                ts

                unionResult =
                    Array.foldl
                        (\union acc ->
                            Result.andThen
                                (\unions ->
                                    canonicalizeUnion realName externalAliases parsedLocalTypes expressionContext union.value.value
                                        |> Result.map
                                            (\u ->
                                                Dict.set
                                                    union.value.value.name.value
                                                    u
                                                    unions
                                            )
                                )
                                acc
                        )
                        (Ok Dict.empty)
                        impl.unions

                contextWithUnions =
                    unionResult
                        |> Result.map
                            (\us ->
                                Dict.values us
                                    |> Array.foldl
                                        (\union acc ->
                                            Array.foldl
                                                (\variant acc2 ->
                                                    Dict.set
                                                        variant.name
                                                        { first =
                                                             { module_ = realName
                                                             , package = impl.package
                                                             , union = union
                                                             , name = variant.name
                                                             , index = variant.index
                                                             , argType = variant.arg
                                                             }
                                                        -- TODO: what about collisions?
                                                        , rest = []
                                                        }
                                                        acc2
                                                )
                                                acc
                                                union.alts
                                        )
                                        Dict.empty
                            )
                        |> Result.map
                            (\ctors ->
                                -- TODO: What about collisions?
                                { expressionContext | scopedCtors = Dict.union ctors expressionContext.scopedCtors }
                            )
                        -- TODO: swallows error
                        |> Result.withDefault expressionContext

                decsResult =
                    Array.foldl
                        (\decl declsResult ->
                            Result.andThen
                                (\decls ->
                                    canonicalizeDef contextWithUnions scopedTypes parsedLocalTypes decl.value.value
                                        |> Result.map (\d -> CanonicalAst.Declare { def = d, decls = decls })
                                )
                                declsResult
                        )
                        (Ok CanonicalAst.SaveTheEnvironment)
                        impl.values
            in
            Ok
                (\canonicalExports canonicalEffects canAlias canUnions canDecls ->
                    { name = realName
                    , package = impl.package
                    , exports = canonicalExports
                    , decls = canDecls
                    , unions = canUnions
                    , aliases = canAlias
                    , binops = canBinops
                    , effects = canonicalEffects
                    }
                )
                |> Result.andMap exportsResult
                |> Result.andMap effectsResult
                |> Result.andMap typeAliasResult
                |> Result.andMap unionResult
                |> Result.andMap decsResult
                |> Result.map
                    (\newModule ->
                        { context | modules = Dict.set (ModuleName.toString newModule.name) newModule context.modules }
                    )

        ParseAst.Signature sig ->
            let
                typeNames =
                    Array.map (\v -> v.value.value.name.value) sig.types

                localTypes =
                    Array.foldl
                        (\name scope ->
                            ScopedEntries.add
                                name
                                (CanonicalAst.TType
                                    { home = sig.name.value
                                    , name = name
                                    , vars = []
                                    }
                                )
                                scope
                        )
                        ScopedEntries.empty
                        typeNames

                canResult =
                    Array.foldl
                        (\value accResult ->
                            Result.andThen
                                (\acc ->
                                    canonicalizeType realName localTypes Dict.empty value.value.value.signature
                                        |> Result.map
                                            (\t ->
                                                Dict.set
                                                    value.value.value.name.value
                                                    t
                                                    acc
                                            )
                                )
                                accResult
                        )
                        (Ok Dict.empty)
                        sig.values

            in
            Result.map
                (\canValues ->
                    let
                        sigModule =
                            { name = sig.name.value
                            , package = sig.package
                            , typeNames = typeNames
                            , values = canValues
                            }
                    in
                    { context | signatures = Dict.set (ModuleName.toString sig.name.value) sigModule context.signatures }
                )
                canResult


createExpressionContext : PackageName -> Context -> ParseAst.ModuleImplementation -> Expression.Context
createExpressionContext pkg moduleContext parsedModule =
    let
        topLevelScope =
            Array.foldl
                (\val dict ->
                    Dict.set
                        val.value.value.name.value
                        (Expression.Local { position = { start = val.start, end = val.end } })
                        dict
                )
                Dict.empty
                parsedModule.values

        qualifiedVarsFromImplementations =
            Array.foldl
                (extractQualifiedVarsImplHelper moduleContext.modules)
                Dict.empty
                (Array.map .value parsedModule.imports)

        qualifiedVars =
            Array.foldl
                (extractQualifiedVarsSigHelper moduleContext.signatures)
                qualifiedVarsFromImplementations
                (Array.map .value parsedModule.requires)

        scopedCtorsFromImports =
            Array.foldl
                (\val dict ->
                    when Dict.get (ModuleName.toString val.value.module_.value) moduleContext.modules is
                        Nothing ->
                            dict

                        Just canMod ->
                            when canMod.exports is
                                CanonicalAst.Export _ ->
                                    dict

                                CanonicalAst.ExportEverything _ ->
                                    Dict.foldl
                                        (\_ union acc ->
                                            Array.foldl
                                                (\variant acc2 ->
                                                    Dict.set
                                                        variant.name
                                                        { first =
                                                             { module_ = canMod.name
                                                             , package = canMod.package
                                                             , union = union
                                                             , name = variant.name
                                                             , index = variant.index
                                                             , argType = variant.arg
                                                             }
                                                        -- TODO: what about collisions?
                                                        , rest = []
                                                        }
                                                        acc2
                                                )
                                                acc
                                                union.alts
                                        )
                                        dict
                                        canMod.unions
                )
                Dict.empty
                parsedModule.imports
    in
    { pkg = pkg
    , currentModule = parsedModule.name.value
    , qualifiedVars = qualifiedVars
    , qualifiedCtors = Dict.empty
    , scope =
        Array.foldl
            (extractExposedVals moduleContext.modules)
            topLevelScope
            (Array.map .value parsedModule.imports) -- TODO: de-duplicate
    , scopedCtors = scopedCtorsFromImports
    , scopedOperators =
        parsedModule.binops
            |> Array.map .value
            |> Array.foldl
                (\infix acc ->
                    Dict.set infix.symbol { moduleName = parsedModule.name.value, operator = infix } acc
                )
                Dict.empty
    }


extractQualifiedVarsImplHelper : Dict String CanonicalAst.Module -> ParseAst.Import -> Dict String (Dict String (Expression.OneOrMore Expression.QualifiedEntry)) -> Dict String (Dict String (Expression.OneOrMore Expression.QualifiedEntry))
extractQualifiedVarsImplHelper canModules mod qv =
    let
        modName =
            mod.module_.value

        qualifier =
            mod.alias
                |> Maybe.withDefault modName

        values =
            Dict.get (ModuleName.toString modName) canModules
                |> Maybe.map
                    (\m ->
                        let
                            normalizedDefs =
                                CanonicalAst.flattenDecls m.decls
                                    |> Array.map
                                        (\d ->
                                            when d is
                                                CanonicalAst.Def { name } ->
                                                    { name = name.value
                                                    , module_ = modName
                                                    , package = m.package
                                                    , annotation = dummyAnnotation -- TODO
                                                    }

                                                CanonicalAst.TypedDef { name } ->
                                                    { name = name.value
                                                    , module_ = modName
                                                    , package = m.package
                                                    , annotation = dummyAnnotation -- TODO
                                                    }
                                        )
                        in
                        when m.exports is
                            CanonicalAst.ExportEverything _ ->
                                normalizedDefs

                            CanonicalAst.Export exportDict ->
                                let
                                    names =
                                        Dict.keys exportDict
                                in
                                Array.keepIf (\d -> Array.member d.name names) normalizedDefs
                    )
                |> Maybe.withDefault [] -- In theory, this will never happen
    in
    -- TODO: What if there are multiple modules of the same name from different packages?
    Dict.set
        (ModuleName.toString qualifier)
        (Array.foldl
            (\def acc ->
                Dict.set
                    def.name
                    { first =
                        { module_ = def.module_
                        , package = def.package
                        , annotation = def.annotation
                        }
                    , rest = []
                    }
                    acc
            )
            Dict.empty
            values
        )
        qv


extractQualifiedVarsSigHelper : Dict String CanonicalAst.Signature -> ParseAst.Require -> Dict String (Dict String (Expression.OneOrMore Expression.QualifiedEntry)) -> Dict String (Dict String (Expression.OneOrMore Expression.QualifiedEntry))
extractQualifiedVarsSigHelper canSignatures mod qv =
    let
        modName =
            mod.module_.value

        qualifier =
            mod.alias
                |> Maybe.withDefault modName

        values =
            Dict.get (ModuleName.toString modName) canSignatures
                |> Maybe.map
                    (\m ->
                        Dict.foldl
                            (\name value acc ->
                                Array.pushLast
                                    { name = name
                                    , module_ = modName
                                    , package = m.package
                                    , annotation = dummyAnnotation -- TODO
                                    }
                                    acc
                            )
                            []
                            m.values
                    )
                |> Maybe.withDefault [] -- In theory, this will never happen
    in
    -- TODO: What if there are multiple modules of the same name from different packages?
    Dict.set
        (ModuleName.toString qualifier)
        (Array.foldl
            (\def acc ->
                Dict.set
                    def.name
                    { first =
                        { module_ = def.module_
                        , package = def.package
                        , annotation = def.annotation
                        }
                    , rest = []
                    }
                    acc
            )
            Dict.empty
            values
        )
        qv


extractExposedVals : Dict String CanonicalAst.Module -> ParseAst.Import -> Dict String Expression.ScopeEntry -> Dict String Expression.ScopeEntry
extractExposedVals canModules mod scope =
    let
        modName =
            mod.module_.value

        values =
            -- TODO: de-duplicate
            Dict.get (ModuleName.toString modName) canModules
                |> Maybe.map
                    (\m ->
                        let
                            normalizedDefs =
                                CanonicalAst.flattenDecls m.decls
                                    |> Array.map
                                        (\d ->
                                            when d is
                                                CanonicalAst.Def { name } ->
                                                    { name = name.value
                                                    , module_ = modName
                                                    , package = m.package
                                                    , annotation = dummyAnnotation -- TODO
                                                    , position = { start = name.start, end = name.end}
                                                    }

                                                CanonicalAst.TypedDef { name } ->
                                                    { name = name.value
                                                    , module_ = modName
                                                    , package = m.package
                                                    , annotation = dummyAnnotation -- TODO
                                                    -- TODO: add located -> region function
                                                    , position = { start = name.start, end = name.end}
                                                    }
                                        )
                        in
                        when m.exports is
                            CanonicalAst.ExportEverything _ ->
                                normalizedDefs

                            CanonicalAst.Export exportDict ->
                                let
                                    names =
                                        Dict.keys exportDict
                                in
                                Array.keepIf (\d -> Array.member d.name names) normalizedDefs
                    )
                |> Maybe.withDefault [] -- In theory, this will never happen
    in
    Array.foldl
        (\def acc ->
            let
                entry =
                    Expression.Imported
                        { entry = 
                            { module_ = def.module_
                            , package = def.package
                            , annotation = def.annotation
                            }
                        , position = def.position
                        }
            in
            -- TODO: what about conflicts?
            Dict.set def.name entry acc
        )
        scope
        values


dummyAnnotation : CanonicalAst.Annotation
dummyAnnotation =
    { freeVars = Set.empty
    , tipe = CanonicalAst.TVar "x"
    }


{-| Canonicalize exports from a module.
-}
canonicalizeExports : ParseAst.ModuleImplementation -> SourcePosition.Region -> Result Error CanonicalAst.Exports
canonicalizeExports impl region =
    when impl.exports is
        ParseAst.Open ->
            Ok (CanonicalAst.ExportEverything region)

        ParseAst.Explicit list ->
            Array.foldl
                (\exp accResult ->
                    Result.andThen
                        (\acc ->
                            when exp is
                                ParseAst.ExposedLower low ->
                                    if Dict.member low.value acc then
                                        -- TODO: Test
                                        Err (ExposedTwice low)

                                    else if Array.any (\v -> low.value == v.value.value.name.value) impl.values then
                                        Ok (Dict.set low.value (SourcePosition.swap CanonicalAst.ExportValue low) acc)

                                    else
                                        -- TODO: Test
                                        Err (ExposeNotFound low)

                                ParseAst.ExposedUpper up ->
                                    if Dict.member up.name.value acc then
                                        Err (ExposedTwice up.name)

                                    else if Array.any (\v -> up.name.value == v.value.value.name.value) impl.unions then
                                        let
                                            exposeType =
                                                when up.privacy is
                                                    ParseAst.Private ->
                                                        CanonicalAst.ExportUnionClosed

                                                    ParseAst.Public ->
                                                        CanonicalAst.ExportUnionOpen
                                        in
                                        Ok (Dict.set up.name.value (SourcePosition.swap exposeType up.name) acc)

                                    else if Array.any (\v -> up.name.value == v.value.value.name.value) impl.aliases then
                                        Ok (Dict.set up.name.value (SourcePosition.swap CanonicalAst.ExportAlias up.name) acc)

                                    else
                                        Err (ExposeNotFound up.name)

                                ParseAst.ExposedOperator op ->
                                    if Dict.member op.value acc then
                                        Err (ExposedTwice op)

                                    else if Array.any (\v -> op.value == v.value.symbol) impl.binops then
                                        Ok (Dict.set op.value (SourcePosition.swap CanonicalAst.ExportBinop op) acc)

                                    else
                                        Err (ExposeNotFound op)
                        )
                        accResult
                )
                (Ok Dict.empty)
                list
                |> Result.map CanonicalAst.Export


{-| Canonicalize a single union
-}
canonicalizeUnion : ModuleName -> ScopedEntries CanonicalAst.Type -> Dict String LocalTypeKind -> Expression.Context -> ParseAst.Union -> Result Error CanonicalAst.Union
canonicalizeUnion moduleName knownTypes localParsedTypes context value =
    let
        altsResult =
            Array.indexedMap
                (\idx { value = variant } ->
                    when variant.payload is
                        Nothing ->
                            Ok
                                { name = variant.name.value
                                , index = idx
                                , arg = Nothing
                                }

                        Just payload ->
                            canonicalizeType moduleName knownTypes localParsedTypes payload
                                |> Result.map
                                    (\canType ->
                                        { name = variant.name.value
                                        , index = idx
                                        , arg = Just canType
                                        }
                                    )
                )
                value.variants
    in
    when Result.allOk altsResult is
        Ok alts ->
            Ok
                { name = value.name.value
                , vars = Array.map .value value.vars
                , alts = alts
                , opts =
                    when value.variants is
                        [ { value = { payload = Just _ } } ] ->
                            CanonicalAst.Unbox

                        _ ->
                            if Array.any (\var -> var.value.payload /= Nothing ) value.variants then
                                CanonicalAst.Normal

                            else
                                CanonicalAst.Enum
                }

        Err errs ->
            when Array.popFirst errs is
                Just { first } ->
                    Err first

                Nothing ->
                    Err PlaceholderError


{-| Canonicalize a single definition (value).
-}
canonicalizeDef : Expression.Context -> ScopedEntries CanonicalAst.Type -> Dict String LocalTypeKind -> ParseAst.Value -> Result Error CanonicalAst.Def
canonicalizeDef context knownTypes parsedLocalTypes value =
    Result.map3
        (\maybeSign params body ->
            when maybeSign is
                Nothing ->
                    CanonicalAst.Def
                        { name = value.name
                        , params = params
                        , body = body
                        }

                Just sign ->
                    CanonicalAst.TypedDef
                        { name = value.name
                        , freeVars = Set.empty -- TODO
                        , params =
                            -- TODO: what about when params > types?
                            Array.map2
                                (\p t -> { pattern = p, tipe = t })
                                params
                                (tipeAsArray sign)
                        , body = body
                        , signature = sign
                        }
        )
        (when value.signature is
            Nothing ->
                Ok Nothing

            Just s ->
                canonicalizeType context.currentModule knownTypes parsedLocalTypes s.type_
                    |> Result.map Just
        )
        (Array.foldl
            (\pat acc ->
                Result.andThen
                    (\current ->
                        Result.map
                            (\p -> Array.append current [p])
                            (Expression.canonicalizePattern context pat)
                    )
                    acc
            )
            (Ok [])
            value.args
            |> Result.mapError ExpressionError
        )
        (Expression.canonicalize context value.body |> Result.mapError ExpressionError)


tipeAsArray : CanonicalAst.Type -> Array CanonicalAst.Type
tipeAsArray t =
    when t is
        CanonicalAst.TLambda { from, to } ->
            Array.pushFirst from (tipeAsArray to)

        _ ->
            [ t ]


dealias : Array { name : String, tipe : CanonicalAst.Type } -> CanonicalAst.AliasType -> CanonicalAst.Type
dealias args t =
    when t is
        CanonicalAst.Holey t_ ->
            dealiasHelp
                (Array.foldl (\{ name, tipe } dict -> Dict.set name tipe dict) Dict.empty args)
                t_

        CanonicalAst.Filled t_ ->
            t_


dealiasHelp : Dict String CanonicalAst.Type -> CanonicalAst.Type -> CanonicalAst.Type
dealiasHelp typeTable t =
    when t is
        CanonicalAst.TLambda { from, to } ->
            CanonicalAst.TLambda
                { from = dealiasHelp typeTable from
                , to = dealiasHelp typeTable to
                }

        CanonicalAst.TVar x ->
            Dict.get x typeTable
                |> Maybe.withDefault t

        CanonicalAst.TType { home, name, vars } ->
            CanonicalAst.TType
                { home = home
                , name = name
                , vars = Array.map (dealiasHelp typeTable) vars
                }

        CanonicalAst.TAlias { home, name, fields, aliasTipe } ->
            CanonicalAst.TAlias
                { home = home
                , name = name
                , fields =
                    Array.map
                        (\{ name = n, tipe = t_ } -> { name = n, tipe = dealiasHelp typeTable t_ })
                        fields
                , aliasTipe = aliasTipe
                }

        CanonicalAst.TRecord { fields, alias } ->
            CanonicalAst.TRecord
                { fields = Dict.map (\_ v -> dealiasHelp typeTable v) fields
                , alias = alias
                }


deepDealias : CanonicalAst.Type -> CanonicalAst.Type
deepDealias t =
    when t is
        CanonicalAst.TLambda { from, to } ->
            CanonicalAst.TLambda
                { from = deepDealias from
                , to = deepDealias to
                }

        CanonicalAst.TVar _ ->
            t

        CanonicalAst.TType { home, name, vars } ->
            CanonicalAst.TType
                { home = home
                , name = name
                , vars = Array.map deepDealias vars
                }

        CanonicalAst.TAlias { fields, aliasTipe } ->
            deepDealias (dealias fields aliasTipe)

        CanonicalAst.TRecord { fields, alias } ->
            CanonicalAst.TRecord
                { fields = Dict.map (\_ v -> deepDealias v) fields
                , alias = alias
                }


{-| Canonicalize effects.
-}
canonicalizeEffects : ModuleName -> ScopedEntries CanonicalAst.Type -> Dict String LocalTypeKind -> ParseAst.Effects -> Result Error CanonicalAst.Effects
canonicalizeEffects home scopedTypes parsedLocalTypes effects =
    when effects is
        ParseAst.NoEffects ->
            Ok CanonicalAst.NoEffects

        ParseAst.Ports ports ->
            Array.foldl
                (\p accResult ->
                    Result.map2
                        (\canP acc ->
                            Dict.set p.value.value.name.value canP acc
                        )
                        (canonicalizePort home scopedTypes parsedLocalTypes p.value.value)
                        accResult
                        
                )
                (Ok Dict.empty)
                ports
                |> Result.map CanonicalAst.Ports

        ParseAst.Manager _ ->
            Err PlaceholderError


canonicalizePort : ModuleName -> ScopedEntries CanonicalAst.Type -> Dict String LocalTypeKind -> ParseAst.Port -> Result Error CanonicalAst.Port
canonicalizePort moduleName scopedTypes parsedLocalTypes port_ =
    canonicalizeType moduleName scopedTypes parsedLocalTypes port_.signature
        |> Result.andThen 
            (\canType ->
                when Array.popLast (tipeAsArray (deepDealias canType)) is
                    -- Cmd/Sub
                    Just { last = CanonicalAst.TType { home, name, vars = [msg] }, initial } ->
                        if home == ModuleName.cmd && name == "Cmd" then
                            when initial is
                                [] ->
                                    Err PlaceholderError

                                [ outgoingType ] ->
                                    when msg is
                                        CanonicalAst.TVar _ ->
                                            when checkPayload outgoingType is
                                                Ok _ ->
                                                    Ok
                                                        ( CanonicalAst.Outgoing
                                                            { freeVars = Set.empty -- TODO
                                                            , func = canType
                                                            , payload = outgoingType
                                                            }
                                                        )

                                                Err _ ->
                                                    Err PlaceholderError

                                        _ ->
                                            Err PlaceholderError

                                _ ->
                                    Err PlaceholderError

                        else
                            Err PlaceholderError

                    -- Task ports
                    Just { last = CanonicalAst.TType { home, name, vars } } ->
                        Err PlaceholderError

                    _ ->
                        -- Isn't actually possible
                        Err PlaceholderError
            )


checkPayload : CanonicalAst.Type -> Result { tipe : CanonicalAst.Type, error : Error } {}
checkPayload tipe =
  when tipe is
    CanonicalAst.TAlias { fields, aliasTipe } ->
      checkPayload (dealias fields aliasTipe)

    CanonicalAst.TType { home, name, vars } ->
      when vars is
        [] ->
            if
                (home == ModuleName.jsonEncode && name == "Value")
                || (home == ModuleName.string && name == "String")
                || (home == ModuleName.basics && name == "Int")
                || (home == ModuleName.basics && name == "Float")
                || (home == ModuleName.basics && name == "Bool")
                || (home == ModuleName.bytes && name == "Bytes")
            then
                Ok {}

            else
                Err { tipe = tipe, error = PlaceholderError }

        [var] ->
            if
                (home == ModuleName.maybe && name == "Maybe")
                || (home == ModuleName.array && name == "Array")
            then
                checkPayload var

            else
                Err { tipe = tipe, error = PlaceholderError }

        _ ->
          Err { tipe = tipe, error = PlaceholderError }

    CanonicalAst.TVar _ ->
      Err { tipe = tipe, error = PlaceholderError }

    CanonicalAst.TLambda _ ->
      Err { tipe = tipe, error = PlaceholderError }

    CanonicalAst.TRecord { alias = Just _ } ->
      Err { tipe = tipe, error = PlaceholderError }

    CanonicalAst.TRecord { fields, alias = Nothing } ->
        Dict.foldl
            (\_ t accResult ->
                Result.andThen (\_ -> checkPayload t) accResult
            )
            (Ok {})
            fields


type LocalTypeKind
    = CustomType (Array String)
    | TypeAlias ParseAst.Alias
    

canonicalizeType : ModuleName -> ScopedEntries CanonicalAst.Type -> Dict String LocalTypeKind -> ParseAst.Type -> Result Error CanonicalAst.Type
canonicalizeType home scopedTypes parsedLocalTypes tipe =
    when tipe.value is
        ParseAst.TLambda lambda ->
            Result.map2
                (\from to -> CanonicalAst.TLambda { from = from, to = to })
                (canonicalizeType home scopedTypes parsedLocalTypes lambda.from)
                (canonicalizeType home scopedTypes parsedLocalTypes lambda.to)

        ParseAst.TVar name ->
            Ok (CanonicalAst.TVar name)

        ParseAst.TType { name, args } ->
            -- TODO: args
            when Dict.get name.value scopedTypes.unqualified is
                Just { first = t, rest = [] } ->
                    Ok t

                -- TODO: handle duplicates
                Just _ ->
                    Err PlaceholderError

                Nothing ->
                    when Dict.get name.value parsedLocalTypes is
                        Just (TypeAlias alias) ->
                            canonicalizeType home scopedTypes parsedLocalTypes alias.type_
                                |> Result.map
                                    (\canType ->
                                        CanonicalAst.TAlias
                                            { home = home
                                            , name = name.value
                                            -- TODO: can args
                                            , fields =
                                                Array.map
                                                    (\v ->
                                                        { name = v.value
                                                        , tipe = CanonicalAst.TVar v.value
                                                        }
                                                    )
                                                    alias.vars
                                            , aliasTipe = CanonicalAst.Holey canType
                                            }
                                    )

                        Just (CustomType vars) ->
                            Ok
                                (CanonicalAst.TType
                                    { home = home
                                    , name = name.value
                                    -- TODO: use provided args, only use type vars to verify arity
                                    , vars = Array.map CanonicalAst.TVar vars
                                    }
                                )

                        Nothing ->
                            Err PlaceholderError

        ParseAst.TTypeQual { varRegion, qualifier, name, args } ->
            -- TODO: args
            when Dict.get qualifier scopedTypes.qualified is
                Just inMod ->
                    when Dict.get name inMod is
                        Just { first = t, rest = [] } ->
                            Ok t

                        -- TODO: handle duplicates
                        _ ->
                            Err PlaceholderError

                Nothing ->
                    Err PlaceholderError

        ParseAst.TRecord { fields, extending } ->
            let
                canFieldResult =
                    Array.foldl
                        (\field acc ->
                            Result.andThen
                                (\canFields ->
                                    canonicalizeType home scopedTypes parsedLocalTypes field.signature
                                        |> Result.map
                                            (\canField ->
                                                Dict.set
                                                    field.field.value
                                                    canField
                                                    canFields
                                            )
                                )
                                acc
                        )
                        (Ok Dict.empty)
                        fields
            in
            Result.map
                (\canFields ->
                    CanonicalAst.TRecord
                        { fields = canFields
                        -- TODO: alias or extends?
                        , alias = Maybe.map .value extending
                        }
                )
                canFieldResult

        ParseAst.TParens pTipe ->
            canonicalizeType home scopedTypes parsedLocalTypes pTipe


-- APPLY MODULE PARAMS


applyModuleParameters : Array ModuleName -> SourceModule -> SourceModule
applyModuleParameters args sourceModule =
    when sourceModule.ast is
        ParseAst.Signature _ ->
            -- TODO: shouldn't happen
            sourceModule

        ParseAst.Implementation impl ->
            let
                newImports =
                    Array.map2
                        (\arg req ->
                            let
                                argNameLength =
                                    ModuleName.toString arg
                                        |> String.count
                            in
                            SourcePosition.at
                                req.start
                                req.end
                                { module_ =
                                    SourcePosition.at
                                        req.value.module_.start
                                        { req.value.module_.start
                                            | col = req.value.module_.start.col + argNameLength
                                        }
                                        arg
                                , args = []
                                , alias = req.value.alias
                                , expose = req.value.expose
                                }
                        )
                        args
                        impl.requires
            in
            { package = sourceModule.package
            , ast = ParseAst.Implementation
                { impl
                    | requires = []
                    , imports = newImports ++ impl.imports
                }
            }
